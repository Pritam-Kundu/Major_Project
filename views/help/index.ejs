<% layout("layouts/boilerplate") %>

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1>
            Help Center
        </h1>

        <p class="text-muted">

            How can we help you today?

        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card h-100 shadow">

                <div class="card-body text-center">

                    <i class="fa-solid fa-calendar-check fa-3x text-primary mb-3"></i>

                    <h4>Booking Help</h4>

                    <p>

                        Learn how to make, modify and cancel bookings.

                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card h-100 shadow">

                <div class="card-body text-center">

                    <i class="fa-solid fa-credit-card fa-3x text-success mb-3"></i>

                    <h4>Payments</h4>

                    <p>

                        GST, refunds and payment information.

                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card h-100 shadow">

                <div class="card-body text-center">

                    <i class="fa-solid fa-house fa-3x text-danger mb-3"></i>

                    <h4>Hosting</h4>

                    <p>

                        Learn how to list and manage properties.

                    </p>

                </div>

            </div>

        </div>

    </div>

    <hr class="my-5">

    <h3 class="mb-4">

        Frequently Asked Questions

    </h3>

    <div class="accordion" id="faqAccordion">

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#one">

                    How do I book a property?

                </button>

            </h2>

            <div id="one" class="accordion-collapse collapse show">

                <div class="accordion-body">

                    Open any listing, select dates, choose guests and click Reserve.

                </div>

            </div>

        </div>

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#two">

                    How do I cancel a booking?

                </button>

            </h2>

            <div id="two" class="accordion-collapse collapse">

                <div class="accordion-body">

                    Go to My Bookings and click Cancel Booking.

                </div>

            </div>

        </div>

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#three">

                    How do I contact support?

                </button>

            </h2>

            <div id="three" class="accordion-collapse collapse">

                <div class="accordion-body">

                    Click the Contact Support button below.

                </div>

            </div>

        </div>

    </div>

    <div class="text-center mt-5">

        <a href="/help/contact"
           class="btn btn-danger btn-lg">

            Contact Support

        </a>

    </div>

</div>