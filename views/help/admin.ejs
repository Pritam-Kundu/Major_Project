<% layout("layouts/boilerplate") %>

<style>
  .admin-container {
    background-color: #fbfaf8;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.05);
    margin: 2rem auto 4rem auto;
    padding: 3rem 2rem;
    max-width: 1100px;
  }

  @media (min-width: 768px) {
    .admin-container {
      padding: 4rem 5rem;
    }
  }

  .auth-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3rem;
    color: #111;
    margin-bottom: 2rem;
    text-align: center;
  }

  /* Elegant Table Styling */
  .custom-table {
    width: 100%;
    margin-top: 1rem;
    border-collapse: separate;
    border-spacing: 0;
  }

  .custom-table th {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #555;
    padding: 1rem 1rem;
    border-bottom: 2px solid #e0e0e0;
    text-align: left;
  }

  .custom-table td {
    padding: 1.2rem 1rem;
    vertical-align: middle;
    color: #333;
    border-bottom: 1px solid #e0e0e0;
    font-size: 0.95rem;
  }

  .custom-table tbody tr {
    transition: background-color 0.2s ease;
  }

  .custom-table tbody tr:hover {
    background-color: #fff;
  }

  .status-badge {
    padding: 0.4rem 0.8rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    display: inline-block;
  }

  .status-open {
    background-color: #e3f2fd;
    color: #0d47a1;
  }
  
  .status-inprogress {
    background-color: #fff3e0;
    color: #e65100;
  }

  .status-resolved {
    background-color: #e8f5e9;
    color: #1b5e20;
  }

  .auth-btn-dark {
    background: #000;
    color: #fff;
    border: 1px solid #000;
    padding: 8px 16px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.3s;
    border-radius: 2px;
  }

  .auth-btn-dark:hover {
    background: #333;
    color: #fff;
  }

  .auth-btn-outline {
    background: transparent;
    color: #000;
    border: 1px solid #c4c4c4;
    padding: 8px 16px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.3s;
    border-radius: 2px;
  }

  .auth-btn-outline:hover {
    border-color: #000;
    background: #fbfaf8;
    color: #000;
  }

  .elegant-select {
    border: 1px solid #c4c4c4;
    border-radius: 2px;
    padding: 8px 12px;
    font-size: 0.85rem;
    color: #333;
    background-color: transparent;
    transition: border-color 0.2s;
    width: 100%;
    margin-bottom: 0.5rem;
  }

  .elegant-select:focus {
    outline: none;
    border-color: #222;
    box-shadow: none;
  }

  /* Modal Styling */
  .modal-content {
    border-radius: 8px;
    border: none;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
  }
  
  .modal-header {
    border-bottom: 1px solid #e0e0e0;
    background-color: #fbfaf8;
    border-radius: 8px 8px 0 0;
  }

  .modal-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    color: #111;
  }

  .modal-footer {
    border-top: 1px solid #e0e0e0;
  }
</style>

<div class="admin-container">
    <h1 class="auth-title">Support Dashboard</h1>

    <% if (tickets && tickets.length > 0) { %>
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Subject</th>
                    <th>Status</th>
                    <th>Details</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% tickets.forEach(ticket => { %>
                    <tr>
                        <td>
                            <% if (ticket.user) { %>
                                <div class="fw-semibold text-dark"><%= ticket.user.username %></div>
                                <div class="text-muted" style="font-size: 0.8rem;">
                                    <i class="fa-regular fa-envelope me-1"></i><%= ticket.user.email %>
                                </div>
                            <% } else { %>
                                <span class="text-danger fw-semibold" style="font-size: 0.85rem;">User Not Found</span>
                            <% } %>
                        </td>
                        <td class="fw-medium"><%= ticket.subject %></td>
                        <td>
                            <span class="status-badge 
                                <%= ticket.status === 'Open' ? 'status-open' : '' %>
                                <%= ticket.status === 'In Progress' ? 'status-inprogress' : '' %>
                                <%= ticket.status === 'Resolved' ? 'status-resolved' : '' %>
                            ">
                                <%= ticket.status %>
                            </span>
                        </td>
                        <td>
                            <button class="auth-btn-outline" data-bs-toggle="modal" data-bs-target="#ticketModal<%= ticket._id %>">
                                <i class="fa-regular fa-eye"></i> View
                            </button>
                        </td>
                        <td>
                            <form action="/help/<%= ticket._id %>?_method=PUT" method="POST" class="d-flex flex-column">
                                <select name="status" class="elegant-select">
                                    <option <%=ticket.status==="Open" ?"selected":"" %>>Open</option>
                                    <option <%=ticket.status==="In Progress" ?"selected":"" %>>In Progress</option>
                                    <option <%=ticket.status==="Resolved" ?"selected":"" %>>Resolved</option>
                                </select>
                                <button class="auth-btn-dark w-100">Update</button>
                            </form>
                        </td>
                    </tr>

                    <!-- Modal for Ticket Details -->
                    <div class="modal fade" id="ticketModal<%= ticket._id %>" tabindex="-1">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header px-4 py-3">
                                    <h5 class="modal-title">Ticket Details</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body px-4 py-4">
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <p class="mb-2"><strong class="text-dark">Name:</strong> <span class="text-muted"><%= ticket.name %></span></p>
                                            <p class="mb-2"><strong class="text-dark">Email:</strong> <span class="text-muted"><%= ticket.email %></span></p>
                                            <p class="mb-2"><strong class="text-dark">Submitted:</strong> <span class="text-muted"><%= ticket.createdAt.toLocaleString("en-IN") %></span></p>
                                        </div>
                                        <div class="col-md-6">
                                            <p class="mb-2"><strong class="text-dark">Category:</strong> <span class="text-muted"><%= ticket.category %></span></p>
                                            <p class="mb-2"><strong class="text-dark">Subject:</strong> <span class="text-muted"><%= ticket.subject %></span></p>
                                            <p class="mb-2">
                                                <strong class="text-dark">Status:</strong> 
                                                <span class="status-badge ms-2
                                                    <%= ticket.status === 'Open' ? 'status-open' : '' %>
                                                    <%= ticket.status === 'In Progress' ? 'status-inprogress' : '' %>
                                                    <%= ticket.status === 'Resolved' ? 'status-resolved' : '' %>
                                                ">
                                                    <%= ticket.status %>
                                                </span>
                                            </p>
                                        </div>
                                    </div>

                                    <% if(ticket.booking){ %>
                                        <div class="bg-light p-3 rounded-2 mb-4 border" style="border-color: #e0e0e0 !important;">
                                            <h6 class="fw-bold mb-3 text-dark border-bottom pb-2">Related Booking</h6>
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <p class="mb-1"><strong class="text-dark">Property:</strong> <span class="text-muted"><%= ticket.booking.listing.title %></span></p>
                                                    <p class="mb-1"><strong class="text-dark">Booking ID:</strong> <span class="text-muted" style="font-size: 0.85rem;"><%= ticket.booking._id %></span></p>
                                                </div>
                                                <div class="col-sm-6">
                                                    <p class="mb-1"><strong class="text-dark">Dates:</strong> <span class="text-muted"><%= ticket.booking.checkIn.toLocaleDateString("en-IN") %> to <%= ticket.booking.checkOut.toLocaleDateString("en-IN") %></span></p>
                                                    <p class="mb-1"><strong class="text-dark">Guests:</strong> <span class="text-muted"><%= ticket.booking.guests %></span> &bull; <strong class="text-dark">Total:</strong> <span class="text-muted">₹<%= ticket.booking.totalPrice.toLocaleString("en-IN") %></span></p>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>

                                    <h6 class="fw-bold mb-2 text-dark">Message</h6>
                                    <div class="p-3 rounded-2" style="background-color: #fbfaf8; border: 1px solid #e0e0e0; color: #555; line-height: 1.6;">
                                        <%= ticket.message %>
                                    </div>
                                </div>
                                <div class="modal-footer px-4 py-3">
                                    <button class="auth-btn-outline" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </tbody>
        </table>
    </div>
    <% } else { %>
        <div class="text-center py-5">
            <p class="text-muted fst-italic">No support tickets found.</p>
        </div>
    <% } %>
</div>