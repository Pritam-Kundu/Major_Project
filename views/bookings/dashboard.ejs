<% layout("layouts/boilerplate") %>

    <div class="container mt-4">

        <h2 class="mb-4">

            Host Dashboard

        </h2>

        <div class="row">

            <div class="col-md-3">

                <div class="card text-center shadow">

                    <div class="card-body">

                        <h3>

                            <%= totalBookings %>

                        </h3>

                        <p>Total Bookings</p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card text-center shadow">

                    <div class="card-body">

                        <h3>

                            ₹<%= totalRevenue.toLocaleString("en-IN") %>

                        </h3>

                        <p>Total Revenue</p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card text-center shadow">

                    <div class="card-body">

                        <h3>

                            <%= activeBookings %>

                        </h3>

                        <p>Active</p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card text-center shadow">

                    <div class="card-body">

                        <h3>

                            <%= cancelledBookings %>

                        </h3>

                        <p>Cancelled</p>

                    </div>

                </div>

            </div>

        </div>

        <hr class="my-4">

        <h3>

            Recent Bookings

        </h3>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Guest</th>
                        <th>Property</th>
                        <th>Dates</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    <% ownerBookings.forEach(booking => { %>
                        <tr>
                            <td class="fw-bold"><%= booking.user.username %></td>
                            <td><%= booking.listing.title %></td>
                            <td>
                                <%= booking.checkIn.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %> - 
                                <%= booking.checkOut.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %>
                            </td>
                            <td>₹<%= booking.totalPrice.toLocaleString("en-IN") %></td>
                            <td>
                                <span class="badge <%= (booking.status === 'Booked' || booking.status === 'Confirmed') ? 'bg-success' : 'bg-danger' %>">
                                    <%= booking.status %>
                                </span>
                            </td>
                            <td>
                                <% if (booking.status === "Cancelled") { %>
                                    <div class="d-flex flex-column" style="font-size: 0.85rem;">
                                        <span class="text-danger fw-bold"><i class="fa-solid fa-ban me-1"></i> Cancelled By Guest</span>
                                        <span class="text-muted">On: <%= booking.cancelledAt ? new Date(booking.cancelledAt).toLocaleDateString() : 'N/A' %></span>
                                        <span class="text-muted">Reason: <em><%= booking.cancellationReason || 'N/A' %></em></span>
                                        <span class="text-muted">Refund: <strong><%= booking.refundPercentage || 0 %>%</strong></span>
                                    </div>
                                <% } else { %>
                                    <span class="text-muted" style="font-size: 0.85rem;">Guests: <%= booking.guests %></span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

    </div>