<% layout("layouts/boilerplate") %>

<style>
  /* Base Container overriding standard margins */
  .auth-split-container {
    display: flex;
    min-height: 85vh;
    background-color: #fbfaf8; /* Soft cream/off-white background */
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.05);
    margin: 1rem 0 3rem 0;
  }

  /* Left Side: Form Panel */
  .auth-form-panel {
    flex: 1;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  @media (min-width: 768px) {
    .auth-form-panel {
      padding: 4rem 5rem;
    }
  }

  /* Right Side: Image Panel (Hidden on mobile) */
  .auth-image-panel {
    display: none;
    flex: 1;
    background-image: url('https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?q=80&w=1200&auto=format&fit=crop');
    background-size: cover;
    background-position: center;
  }
  @media (min-width: 992px) {
    .auth-image-panel {
      display: block;
    }
  }

  /* Typography */
  .auth-brand {
    font-size: 1.25rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-bottom: 2rem;
    font-weight: 500;
    color: #222;
  }

  .auth-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3.5rem;
    color: #111;
    margin-bottom: 0.5rem;
  }

  .auth-subtitle {
    color: #555;
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }

  /* Form Elements */
  .auth-label-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  
  .auth-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #222;
  }

  .auth-forgot-link {
    font-size: 0.8rem;
    color: #8c7355;
    text-decoration: none;
  }
  .auth-forgot-link:hover {
    text-decoration: underline;
  }

  .auth-input {
    width: 100%;
    background: transparent;
    border: 1px solid #c4c4c4;
    padding: 14px 16px;
    font-size: 1rem;
    color: #333;
    border-radius: 2px;
    margin-bottom: 1.5rem;
    transition: border-color 0.2s;
  }
  
  .auth-input:focus {
    outline: none;
    border-color: #222;
    background: #fff;
  }

  /* Buttons */
  .auth-btn-dark {
    width: 100%;
    background: #000;
    color: #fff;
    border: 1px solid #000;
    padding: 16px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.3s;
    border-radius: 2px;
  }
  .auth-btn-dark:hover {
    background: #333;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 2rem 0;
    color: #888;
    font-size: 0.8rem;
    letter-spacing: 1px;
  }
  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #e0e0e0;
  }
  .auth-divider:not(:empty)::before {
    margin-right: 1.5em;
  }
  .auth-divider:not(:empty)::after {
    margin-left: 1.5em;
  }

  .auth-btn-google {
    width: 100%;
    background: transparent;
    color: #222;
    border: 1px solid #c4c4c4;
    padding: 14px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: background 0.2s;
    border-radius: 2px;
  }
  .auth-btn-google:hover {
    background: #f0f0f0;
  }

  /* Footer */
  .auth-footer {
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.95rem;
    color: #555;
  }
  .auth-footer a {
    color: #8c7355;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .auth-footer a:hover {
    color: #6a563f;
  }
  
  .invalid-feedback {
    display: none;
    color: #d93025;
    font-size: 0.85rem;
    margin-top: -1rem;
    margin-bottom: 1rem;
  }
  
  .was-validated .form-control:invalid ~ .invalid-feedback {
    display: block;
  }
</style>

<div class="auth-split-container">
  
  <!-- Left Form Panel -->
  <div class="auth-form-panel">
    <div class="auth-brand">Wanderlust</div>
    <h1 class="auth-title">Welcome Back</h1>
    <p class="auth-subtitle">Sign in to curate your next exquisite stay.</p>
    
    <form action="/login" method="post" novalidate class="needs-validation">
      
      <div class="auth-label-row">
        <label for="username" class="auth-label">Username</label>
      </div>
      <input
        type="text"
        name="username"
        id="username"
        class="auth-input form-control"
        required
      />
      <div class="invalid-feedback">Please enter your username.</div>

      <div class="auth-label-row">
        <label for="password" class="auth-label">Password</label>
        <a href="#" class="auth-forgot-link">Forgot Password?</a>
      </div>
      <input
        type="password"
        name="password"
        id="password"
        class="auth-input form-control"
        required
      />
      <div class="invalid-feedback">Please enter your password.</div>

      <button type="submit" class="auth-btn-dark">
        Sign In <i class="fa-solid fa-arrow-right"></i>
      </button>
      
      <div class="auth-divider">OR</div>
      
      <button type="button" class="auth-btn-google">
        <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg" alt="Google" width="18" height="18">
        Continue with Google
      </button>
      
      <div class="auth-footer">
        New to Wanderlust? <a href="/signup">Create an account</a>
      </div>
    </form>
  </div>
  
  <!-- Right Image Panel -->
  <div class="auth-image-panel"></div>

</div>
