<% layout("layouts/boilerplate") %>

  

  <div class="auth-split-container">

    <!-- Left Form Panel -->
    <div class="auth-form-panel">
      <a href="/listings" class="auth-brand"
        style="text-decoration:none; display:flex; align-items:center; justify-content:center; gap:8px;">
        <svg class="homigo-logo-icon" viewBox="0 0 100 100" width="36" height="36" xmlns="http://www.w3.org/2000/svg"
          style="vertical-align: middle;">
          <defs>
            <clipPath id="homigo-pin-clip">
              <path d="M 50 95 C 50 95 95 65 95 45 A 45 45 0 0 0 5 45 C 5 65 50 95 50 95 Z" />
            </clipPath>
          </defs>
          <g clip-path="url(#homigo-pin-clip)">
            <rect x="0" y="0" width="100" height="100" fill="#d59d8c" />
            <polygon points="0,65 50,25 100,65 100,100 0,100" fill="#5f788b" />
            <rect x="70" y="25" width="8" height="20" fill="#ffffff" />
            <polyline points="-10,72 50,25 110,72" fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round"
              stroke-linejoin="round" />
          </g>
          <g fill="#ffffff">
            <rect x="41" y="48" width="7" height="7" rx="1" />
            <rect x="52" y="48" width="7" height="7" rx="1" />
            <rect x="41" y="59" width="7" height="7" rx="1" />
            <rect x="52" y="59" width="7" height="7" rx="1" />
          </g>
        </svg>
        <span
          style="font-family: 'Nunito', sans-serif; color: #5f788b; font-weight:800; font-size: 2rem; text-transform:none; letter-spacing:0;">Homigo</span>
      </a>
      <h1 class="auth-title">Welcome Back</h1>
      <p class="auth-subtitle">Sign in to curate your next exquisite stay.</p>

      <form action="/login" method="post" novalidate class="needs-validation">

        <div class="auth-label-row">
          <label for="username" class="auth-label">Email Address</label>
        </div>

        <input type="email" id="username" name="username" class="auth-input form-control" placeholder="Enter your email"
          autocomplete="email" required>

        <div class="invalid-feedback">
          Please enter a valid email address.
        </div>

        <!-- <div class="invalid-feedback">Please enter your username.</div> -->


        <div class="auth-label-row">
          <label for="password" class="auth-label">Password</label>
          <a href="/forgot-password" class="text-decoration-none fw-semibold forgot-link auth-forgot-link">Forgot
            Password?</a>
        </div>
        <div class="position-relative mb-3">
          <input type="password" name="password" id="password" class="auth-input form-control pe-5"
            placeholder="Enter your password" autocomplete="current-password" required style="margin-bottom: 0;" />
          <i class="fa-solid fa-eye password-toggle"></i>
        </div>
        <div class="invalid-feedback">Please enter your password.</div>

        <button type="submit" class="auth-btn-dark">
          Sign In <i class="fa-solid fa-arrow-right"></i>
        </button>

        <div class="auth-divider">OR</div>

        <button id="googleLogin" type="button" class="auth-btn-google">

          <img src="https://developers.google.com/identity/images/g-logo.png" width="18" alt="Google Logo">

          Continue with Google

        </button>

        <div class="auth-footer">
          New to Homigo? <a href="/signup">Create an account</a>
        </div>
      </form>
    </div>

    <!-- Right Image Panel -->
    <div class="auth-image-panel"></div>

  </div>


  <script type="module" src="/js/firebase.js"></script>
  <script type="module" src="/js/googleAuth.js"></script>
  <script src="/js/passwordToggle.js"></script>


  <script>
    (() => {
      'use strict';

      const form = document.querySelector('.needs-validation');
      const email = document.getElementById('username');
      const password = document.getElementById('password');

      form.addEventListener('submit', function (event) {

        // Remove previous validation classes
        email.classList.remove('is-valid', 'is-invalid');
        password.classList.remove('is-valid', 'is-invalid');

        let isValid = true;

        // Email validation
        if (!email.checkValidity()) {
          email.classList.add('is-invalid');
          isValid = false;
        }

        // Password validation
        if (password.value.trim() === "") {
          password.classList.add('is-invalid');
          isValid = false;
        }

        // ⭐ Important part
        // If email is invalid, password should also appear invalid
        if (!email.checkValidity()) {
          password.classList.add('is-invalid');
        }

        if (!isValid) {
          event.preventDefault();
          event.stopPropagation();
        } else {
          email.classList.add('is-valid');
          password.classList.add('is-valid');
        }

      });

    })();
  </script>