<% layout("layouts/boilerplate") %>

  <style>
    /* Base Container overriding standard margins */
    .auth-split-container {
      display: flex;
      min-height: 85vh;
      background-color: #fbfaf8;
      /* Soft cream/off-white background */
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
      margin: 1rem 0 3rem 0;
    }

    /* Left Side: Form Panel */
    .auth-form-panel {
      flex: 1;
      padding: 3rem 2rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    @media (min-width: 768px) {
      .auth-form-panel {
        padding: 4rem 5rem;
      }
    }

    /* Right Side: Image Panel (Hidden on mobile) */
    .auth-image-panel {
      display: none;
      flex: 1;
      background-image: url('https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?q=80&w=1200&auto=format&fit=crop');
      background-size: cover;
      background-position: center;
    }

    @media (min-width: 992px) {
      .auth-image-panel {
        display: block;
      }
    }

    /* Typography */
    .auth-brand {
      font-size: 1.25rem;
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-bottom: 2rem;
      font-weight: 500;
      color: #222;
    }

    .auth-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 3.5rem;
      color: #111;
      margin-bottom: 0.5rem;
    }

    .auth-subtitle {
      color: #555;
      font-size: 1.05rem;
      margin-bottom: 2.5rem;
    }

    /* Form Elements */
    .auth-label-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.5rem;
    }

    .auth-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #222;
    }

    .auth-forgot-link {
      font-size: 0.8rem;
      color: #8c7355;
      text-decoration: none;
    }

    .auth-forgot-link:hover {
      text-decoration: underline;
    }

    .auth-input {
      width: 100%;
      background: transparent;
      border: 1px solid #c4c4c4;
      padding: 14px 16px;
      font-size: 1rem;
      color: #333;
      border-radius: 2px;
      margin-bottom: 1.5rem;
      transition: border-color 0.2s;
    }

    .auth-input:focus {
      outline: none;
      border-color: #222;
      background: #fff;
    }

    /* Buttons */
    .auth-btn-dark {
      width: 100%;
      background: #000;
      color: #fff;
      border: 1px solid #000;
      padding: 16px;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      transition: all 0.3s;
      border-radius: 2px;
    }

    .auth-btn-dark:hover {
      background: #333;
    }

    .auth-divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: 2rem 0;
      color: #888;
      font-size: 0.8rem;
      letter-spacing: 1px;
    }

    .auth-divider::before,
    .auth-divider::after {
      content: '';
      flex: 1;
      border-bottom: 1px solid #e0e0e0;
    }

    .auth-divider:not(:empty)::before {
      margin-right: 1.5em;
    }

    .auth-divider:not(:empty)::after {
      margin-left: 1.5em;
    }

    .auth-btn-google {
      width: 100%;
      background: transparent;
      color: #222;
      border: 1px solid #c4c4c4;
      padding: 14px;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      transition: background 0.2s;
      border-radius: 2px;
    }

    .auth-btn-google:hover {
      background: #f0f0f0;
    }

    /* Footer */
    .auth-footer {
      margin-top: 2.5rem;
      text-align: center;
      font-size: 0.95rem;
      color: #555;
    }

    .auth-footer a {
      color: #8c7355;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .auth-footer a:hover {
      color: #6a563f;
    }

    .invalid-feedback {
      display: none;
      color: #d93025;
      font-size: 0.85rem;
      margin-top: -1rem;
      margin-bottom: 1rem;
    }

    .was-validated .form-control:invalid~.invalid-feedback {
      display: block;
    }

    .forgot-link {

      color: #2f80ed;

      transition: .3s;

    }

    .forgot-link:hover {

      color: #0d6efd;

      text-decoration: underline !important;

    }

    .password-toggle {
      position: absolute;
      right: 18px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #666;
      transition: color .2s;
      z-index: 10;
    }

    .password-toggle:hover {
      color: #000;
    }
  </style>

  <div class="auth-split-container">

    <!-- Left Form Panel -->
    <div class="auth-form-panel">
      <a href="/listings" class="auth-brand"
        style="text-decoration:none; display:flex; align-items:center; justify-content:center; gap:8px;">
        <svg class="homigo-logo-icon" viewBox="0 0 100 100" width="36" height="36" xmlns="http://www.w3.org/2000/svg"
          style="vertical-align: middle;">
          <defs>
            <clipPath id="homigo-pin-clip">
              <path d="M 50 95 C 50 95 95 65 95 45 A 45 45 0 0 0 5 45 C 5 65 50 95 50 95 Z" />
            </clipPath>
          </defs>
          <g clip-path="url(#homigo-pin-clip)">
            <rect x="0" y="0" width="100" height="100" fill="#d59d8c" />
            <polygon points="0,65 50,25 100,65 100,100 0,100" fill="#5f788b" />
            <rect x="70" y="25" width="8" height="20" fill="#ffffff" />
            <polyline points="-10,72 50,25 110,72" fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round"
              stroke-linejoin="round" />
          </g>
          <g fill="#ffffff">
            <rect x="41" y="48" width="7" height="7" rx="1" />
            <rect x="52" y="48" width="7" height="7" rx="1" />
            <rect x="41" y="59" width="7" height="7" rx="1" />
            <rect x="52" y="59" width="7" height="7" rx="1" />
          </g>
        </svg>
        <span
          style="font-family: 'Nunito', sans-serif; color: #5f788b; font-weight:800; font-size: 2rem; text-transform:none; letter-spacing:0;">Homigo</span>
      </a>
      <h1 class="auth-title">Welcome Back</h1>
      <p class="auth-subtitle">Sign in to curate your next exquisite stay.</p>

      <form action="/login" method="post" novalidate class="needs-validation">

        <div class="auth-label-row">
          <label for="username" class="auth-label">Email Address</label>
        </div>

        <input type="email" id="username" name="username" class="auth-input form-control" placeholder="Enter your email"
          autocomplete="email" required>

        <div class="invalid-feedback">
          Please enter a valid email address.
        </div>

        <!-- <div class="invalid-feedback">Please enter your username.</div> -->


        <div class="auth-label-row">
          <label for="password" class="auth-label">Password</label>
          <a href="/forgot-password" class="text-decoration-none fw-semibold forgot-link auth-forgot-link">Forgot
            Password?</a>
        </div>
        <div class="position-relative mb-3">
          <input type="password" name="password" id="password" class="auth-input form-control pe-5"
            placeholder="Enter your password" autocomplete="current-password" required style="margin-bottom: 0;" />
          <i class="fa-solid fa-eye password-toggle"></i>
        </div>
        <div class="invalid-feedback">Please enter your password.</div>

        <button type="submit" class="auth-btn-dark">
          Sign In <i class="fa-solid fa-arrow-right"></i>
        </button>

        <div class="auth-divider">OR</div>

        <button id="googleLogin" type="button" class="auth-btn-google">

          <img src="https://developers.google.com/identity/images/g-logo.png" width="18" alt="Google Logo">

          Continue with Google

        </button>

        <div class="auth-footer">
          New to Homigo? <a href="/signup">Create an account</a>
        </div>
      </form>
    </div>

    <!-- Right Image Panel -->
    <div class="auth-image-panel"></div>

  </div>


  <script type="module" src="/js/firebase.js"></script>
  <script type="module" src="/js/googleAuth.js"></script>
  <script src="/js/passwordToggle.js"></script>


  <script>
    (() => {
      'use strict';

      const form = document.querySelector('.needs-validation');
      const email = document.getElementById('username');
      const password = document.getElementById('password');

      form.addEventListener('submit', function (event) {

        // Remove previous validation classes
        email.classList.remove('is-valid', 'is-invalid');
        password.classList.remove('is-valid', 'is-invalid');

        let isValid = true;

        // Email validation
        if (!email.checkValidity()) {
          email.classList.add('is-invalid');
          isValid = false;
        }

        // Password validation
        if (password.value.trim() === "") {
          password.classList.add('is-invalid');
          isValid = false;
        }

        // ⭐ Important part
        // If email is invalid, password should also appear invalid
        if (!email.checkValidity()) {
          password.classList.add('is-invalid');
        }

        if (!isValid) {
          event.preventDefault();
          event.stopPropagation();
        } else {
          email.classList.add('is-valid');
          password.classList.add('is-valid');
        }

      });

    })();
  </script>