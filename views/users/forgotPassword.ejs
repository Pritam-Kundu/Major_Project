<% layout("layouts/boilerplate") %>

    <style>
        .auth-split-container {
            display: flex;
            min-height: 85vh;
            background: #fbfaf8;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0, 0, 0, .05);
            margin: 1rem 0 3rem;
        }

        .auth-form-panel {
            flex: 1;
            padding: 4rem 5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .auth-image-panel {
            display: none;
            flex: 1;
            background: url("https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?q=80&w=1200&auto=format&fit=crop");
            background-size: cover;
            background-position: center;
        }

        @media(min-width:992px) {
            .auth-image-panel {
                display: block;
            }
        }

        .auth-brand {
            font-size: 1.2rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-bottom: 2rem;
            font-weight: 600;
        }

        .auth-title {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            margin-bottom: .5rem;
        }

        .auth-subtitle {
            color: #666;
            margin-bottom: 2rem;
        }

        .auth-input {
            width: 100%;
            padding: 15px;
            border: 1px solid #ccc;
            margin-bottom: 25px;
            border-radius: 4px;
        }

        .auth-btn {
            width: 100%;
            background: #000;
            color: #fff;
            padding: 15px;
            border: none;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: .3s;
        }

        .auth-btn:hover {
            background: #333;
        }
    </style>

    <div class="auth-split-container">

        <div class="auth-form-panel">

            <a href="/listings" class="auth-brand text-decoration-none">
                Homigo
            </a>

            <h1 class="auth-title">
                Forgot Password
            </h1>

            <p class="auth-subtitle">

                Enter your registered email address.

            </p>

            <form action="/forgot-password" method="POST">

                <input type="email" name="email" class="auth-input" placeholder="Enter your email" required>

                <button class="auth-btn">

                    Send OTP

                </button>

            </form>

        </div>

        <div class="auth-image-panel"></div>

    </div>