<% layout("layouts/boilerplate") %>

  

  <div class="auth-split-container">

    <!-- Left Form Panel -->
    <div class="auth-form-panel">
      <a href="/listings" class="auth-brand"
        style="text-decoration:none; display:flex; align-items:center; justify-content:center; gap:8px;">
        <svg class="homigo-logo-icon" viewBox="0 0 100 100" width="36" height="36" xmlns="http://www.w3.org/2000/svg"
          style="vertical-align: middle;">
          <defs>
            <clipPath id="homigo-pin-clip">
              <path d="M 50 95 C 50 95 95 65 95 45 A 45 45 0 0 0 5 45 C 5 65 50 95 50 95 Z" />
            </clipPath>
          </defs>
          <g clip-path="url(#homigo-pin-clip)">
            <rect x="0" y="0" width="100" height="100" fill="#d59d8c" />
            <polygon points="0,65 50,25 100,65 100,100 0,100" fill="#5f788b" />
            <rect x="70" y="25" width="8" height="20" fill="#ffffff" />
            <polyline points="-10,72 50,25 110,72" fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round"
              stroke-linejoin="round" />
          </g>
          <g fill="#ffffff">
            <rect x="41" y="48" width="7" height="7" rx="1" />
            <rect x="52" y="48" width="7" height="7" rx="1" />
            <rect x="41" y="59" width="7" height="7" rx="1" />
            <rect x="52" y="59" width="7" height="7" rx="1" />
          </g>
        </svg>
        <span
          style="font-family: 'Nunito', sans-serif; color: #5f788b; font-weight:800; font-size: 2rem; text-transform:none; letter-spacing:0;">Homigo</span>
      </a>
      <h1 class="auth-title">Create Account</h1>
      <p class="auth-subtitle">Join us to curate your next exquisite stay.</p>

      <form action="/signup" method="post" novalidate class="needs-validation">

        <div class="auth-label-row">
          <label for="username" class="auth-label">Username</label>
        </div>
        <input type="text" name="username" id="username" class="auth-input form-control" required / autocomplete="username">
        <div class="invalid-feedback">Please enter a valid username.</div>

        <div class="auth-label-row">
          <label for="email" class="auth-label">Email Address</label>
        </div>
        <input type="email" name="email" id="email" class="auth-input form-control" required / autocomplete="email">
        <div class="invalid-feedback">Please provide a valid email.</div>

        <!-- Password -->

        <div class="auth-label-row">
          <label for="password" class="auth-label">
            Password
          </label>
        </div>

        <div class="position-relative mb-3">

          <input type="password" name="password" id="password" class="auth-input form-control pe-5" required autocomplete="new-password">

          <i id="togglePassword" class="fa-solid fa-eye password-toggle position-absolute"
            style="right:18px; top:50%; transform:translateY(-50%); cursor:pointer; color:#666;">
          </i>

        </div>

        <div class="invalid-feedback">
          Please enter a password.
        </div>


        <!-- Password Strength Meter -->

        <div class="progress mt-3">

          <div id="passwordStrength" class="progress-bar bg-danger" role="progressbar" style="width: 0%;">

            Weak

          </div>

        </div>

        <!-- Password Requirements -->

        <ul class="small mt-3 ps-3">

          <li id="length" class="text-danger">
            At least 8 characters
          </li>

          <li id="upper" class="text-danger">
            One uppercase letter (A-Z)
          </li>

          <li id="lower" class="text-danger">
            One lowercase letter (a-z)
          </li>

          <li id="number" class="text-danger">
            One number (0-9)
          </li>

          <li id="special" class="text-danger">
            One special character (!@#$%^&*)
          </li>

        </ul>

        <!-- Confirm Password -->

        <div class="auth-label-row mt-4">
          <label for="confirmPassword" class="auth-label">
            Confirm Password
          </label>
        </div>

        <div class="position-relative mb-3">

          <input type="password" id="confirmPassword" name="confirmPassword" class="auth-input form-control pe-5"
            placeholder="Re-enter your password" required autocomplete="new-password">

          <i id="toggleConfirmPassword" class="fa-solid fa-eye password-toggle position-absolute"
            style="right:18px; top:50%; transform:translateY(-50%); cursor:pointer; color:#666;">
          </i>

        </div>

        <div class="invalid-feedback">
          Passwords do not match.
        </div>

        <button type="submit" class="auth-btn-dark">
          Sign Up <i class="fa-solid fa-arrow-right"></i>
        </button>

        <div class="auth-divider">OR</div>

        <button id="googleLogin" type="button" class="auth-btn-google">

          <img src="https://developers.google.com/identity/images/g-logo.png" width="18" alt="Google Logo">

          Continue with Google

        </button>

        <div class="auth-footer">
          Already have an account?
          <a href="/login">Log in</a>
        </div>

      </form>

    </div>

    <!-- Right Image Panel -->
    <div class="auth-image-panel"></div>

  </div>


  <script type="module" src="/js/firebase.js"></script>
  <script type="module" src="/js/googleAuth.js"></script>
  <script src="/js/passwordToggle.js"></script>
  <script src="/js/passwordValidation.js"></script>