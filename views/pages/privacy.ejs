<% layout("layouts/boilerplate") %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f8f9fc;
            overflow-x: hidden;
        }

        /* HERO */

        .privacy-hero {

            height: 80vh;

            display: flex;

            justify-content: center;

            align-items: center;

            text-align: center;

            color: white;

            background:
                linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .55)),
                url("https://images.unsplash.com/photo-1555949963-aa79dcee981c?auto=format&fit=crop&w=1800&q=80");

            background-size: cover;

            background-position: center;

        }

        .hero-content {

            max-width: 850px;

            padding: 20px;

            animation: fadeUp 1s ease;

        }

        .hero-content h1 {

            font-size: 4rem;

            font-weight: 800;

            margin-bottom: 20px;

        }

        .hero-content p {

            font-size: 1.15rem;

            line-height: 2;

            color: #eee;

        }

        /* COMMON */

        .section {

            padding: 100px 8%;

        }

        .section-title {

            text-align: center;

            font-size: 2.8rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .divider {

            width: 120px;

            height: 5px;

            background: #2f80ed;

            margin: 0 auto 60px;

            border-radius: 30px;

        }

        /* OVERVIEW */

        .privacy-overview {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 60px;

            align-items: center;

        }

        .privacy-overview img {

            width: 100%;

            border-radius: 20px;

            box-shadow: 0 15px 35px rgba(0, 0, 0, .15);

        }

        .overview-content h2 {

            font-size: 2.4rem;

            margin-bottom: 20px;

        }

        .overview-content p {

            line-height: 2;

            color: #666;

            margin-bottom: 20px;

        }

        /* INFO CARDS */

        .info-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .info-card {

            background: white;

            padding: 35px;

            text-align: center;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .info-card:hover {

            transform: translateY(-10px);

        }

        .info-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .info-card h3 {

            margin-bottom: 15px;

            font-weight: 700;

        }

        .info-card p {

            line-height: 1.9;

            color: #666;

        }

        @keyframes fadeUp {

            from {

                opacity: 0;

                transform: translateY(40px);

            }

            to {

                opacity: 1;

                transform: translateY(0);

            }

        }

        

        /* Use Grid */

        .use-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .use-card {

            background: white;

            padding: 35px;

            border-radius: 20px;

            text-align: center;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .use-card:hover {

            transform: translateY(-10px);

        }

        .use-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        /* Sharing */

        .sharing-wrapper {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 60px;

            align-items: center;

        }

        .sharing-content h2 {

            margin-bottom: 20px;

            font-weight: 700;

        }

        .sharing-content p {

            line-height: 2;

            color: #666;

            margin-bottom: 25px;

        }

        .sharing-content ul {

            list-style: none;

            padding: 0;

        }

        .sharing-content li {

            margin-bottom: 18px;

            font-size: 1.05rem;

        }

        .sharing-content i {

            color: #2f80ed;

            margin-right: 12px;

        }

        /* Security */

        .security-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .security-card {

            background: white;

            padding: 35px;

            text-align: center;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .security-card:hover {

            transform: translateY(-10px);

        }

        .security-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        /* Retention */

        .retention-section {

            background: white;

        }

        .retention-box {

            display: flex;

            gap: 30px;

            align-items: flex-start;

            background: #eef5ff;

            padding: 40px;

            border-left: 6px solid #2f80ed;

            border-radius: 20px;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .06);

        }

        .retention-icon i {

            font-size: 60px;

            color: #2f80ed;

        }

        

        /* Rights */

        .rights-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .rights-card {

            background: white;

            padding: 35px;

            text-align: center;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .rights-card:hover {

            transform: translateY(-10px);

        }

        .rights-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        /* Cookies */

        .cookie-wrapper {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 60px;

            align-items: center;

        }

        .cookie-content h2 {

            margin-bottom: 20px;

            font-weight: 700;

        }

        .cookie-content p {

            line-height: 2;

            color: #666;

            margin-bottom: 20px;

        }

        /* Transfer */

        .transfer-box {

            display: flex;

            gap: 30px;

            background: white;

            padding: 40px;

            border-left: 6px solid #2f80ed;

            border-radius: 20px;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

        }

        .transfer-icon i {

            font-size: 60px;

            color: #2f80ed;

        }

        /* Legal */

        .legal-section {

            background: white;

        }

        .legal-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .legal-card {

            background: #f8f9fc;

            padding: 35px;

            text-align: center;

            border-radius: 20px;

            transition: .35s;

        }

        .legal-card:hover {

            transform: translateY(-10px);

        }

        .legal-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        

        /* FAQ */

        .faq-section {

            background: #f7f9fc;

        }

        .accordion-button {

            font-weight: 600;

            font-size: 1.05rem;

        }

        /* Policy Updates */

        .update-box {

            display: flex;

            gap: 30px;

            align-items: flex-start;

            background: #eef5ff;

            padding: 40px;

            border-left: 6px solid #2f80ed;

            border-radius: 20px;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .06);

        }

        .update-box i {

            font-size: 60px;

            color: #2f80ed;

            margin-top: 5px;

        }

        .update-box h3 {

            font-weight: 700;

            margin-bottom: 15px;

        }

        .update-box p {

            line-height: 1.9;

            color: #555;

        }

        /* Last Updated */

        .last-updated {

            max-width: 500px;

            margin: auto;

            background: white;

            padding: 35px;

            border-radius: 20px;

            text-align: center;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

        }

        .last-updated h3 {

            font-weight: 700;

            margin-bottom: 10px;

        }

        .last-updated i {

            color: #2f80ed;

            margin-right: 10px;

        }

        .last-updated p {

            font-size: 1.1rem;

            color: #666;

            margin: 0;

        }

        /* Contact */

        .privacy-contact {

            padding: 120px 8%;

            background: linear-gradient(135deg, #2f80ed, #56ccf2);

            text-align: center;

            color: white;

        }

        .privacy-contact h2 {

            font-size: 3rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .privacy-contact p {

            max-width: 750px;

            margin: 0 auto 40px;

            line-height: 2;

        }

        .contact-buttons {

            display: flex;

            justify-content: center;

            gap: 20px;

            flex-wrap: wrap;

        }

        .contact-buttons .btn {

            padding: 15px 35px;

            border-radius: 50px;

            font-weight: 600;

            transition: .3s;

        }

        .contact-buttons .btn:hover {

            transform: translateY(-5px);

        }

        
    </style>

    <!-- HERO -->

    <section class="privacy-hero">

        <div class="hero-content">

            <h1>

                Privacy Policy

            </h1>

            <p>

                Your privacy matters to us.
                Learn how Homigo collects,
                uses,
                stores,
                and protects your information while providing a secure travel booking experience.

            </p>

        </div>

    </section>

    <!-- OVERVIEW -->

    <section class="section">

        <div class="privacy-overview">

            <img src="https://images.unsplash.com/photo-1563013544-824ae1b704d3?auto=format&fit=crop&w=1000&q=80" alt="Image">

            <div class="overview-content">

                <h2>

                    Protecting Your Information

                </h2>

                <p>

                    Homigo is committed to protecting your personal information and handling it responsibly.
                    We collect only the information necessary to provide our services,
                    improve the platform,
                    and enhance your booking experience.

                </p>

                <p>

                    We implement appropriate technical and organizational measures to help keep your data secure while
                    you use Homigo.

                </p>

            </div>

        </div>

    </section>

    <!-- WHAT WE COLLECT -->

    <section class="section" style="background:white;">

        <h2 class="section-title">

            Information We Collect

        </h2>

        <div class="divider"></div>

        <div class="info-grid">

            <div class="info-card">

                <i class="fa-solid fa-user"></i>

                <h3>

                    Account Information

                </h3>

                <p>

                    Name,
                    email address,
                    profile details,
                    and login credentials.

                </p>

            </div>

            <div class="info-card">

                <i class="fa-solid fa-credit-card"></i>

                <h3>

                    Booking Information

                </h3>

                <p>

                    Reservation details,
                    guest information,
                    and payment-related records.

                </p>

            </div>

            <div class="info-card">

                <i class="fa-solid fa-location-dot"></i>

                <h3>

                    Usage Information

                </h3>

                <p>

                    Recently viewed listings,
                    search preferences,
                    and browsing activity within Homigo.

                </p>

            </div>

            <div class="info-card">

                <i class="fa-solid fa-mobile-screen"></i>

                <h3>

                    Device Information

                </h3>

                <p>

                    Browser type,
                    device information,
                    IP address,
                    and technical diagnostics.

                </p>

            </div>

        </div>

    </section>

    <!-- HOW WE USE INFORMATION -->

    <section class="section">

        <h2 class="section-title">

            How We Use Your Information

        </h2>

        <div class="divider"></div>

        <div class="use-grid">

            <div class="use-card">

                <i class="fa-solid fa-calendar-check"></i>

