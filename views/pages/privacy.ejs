                </p>

                <ul>

                    <li>

                        <i class="fa-solid fa-check"></i>

                        Verified property owners

                    </li>

                    <li>

                        <i class="fa-solid fa-check"></i>

                        Secure payment partners

                    </li>

                    <li>

                        <i class="fa-solid fa-check"></i>

