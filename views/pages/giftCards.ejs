<% layout("layouts/boilerplate") %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {

            background: #f8f9fc;

            overflow-x: hidden;

        }

        /* HERO */

        .gift-hero {

            height: 85vh;

            display: flex;

            justify-content: center;

            align-items: center;

            text-align: center;

            color: white;

            background:

                linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .55)),

                url("https://images.unsplash.com/photo-1513151233558-d860c5398176?auto=format&fit=crop&w=1800&q=80");

            background-size: cover;

            background-position: center;

        }

        .hero-content {

            max-width: 900px;

            padding: 20px;

            animation: fadeUp 1s ease;

        }

        .hero-content h1 {

            font-size: 4rem;

            font-weight: 800;

            margin-bottom: 20px;

        }

        .hero-content p {

            font-size: 1.2rem;

            line-height: 2;

            margin-bottom: 35px;

            color: #eee;

        }

        .hero-btn {

            display: inline-block;

            padding: 16px 40px;

            background: white;

            color: #2f80ed;

            text-decoration: none;

            font-weight: 700;

            border-radius: 50px;

            transition: .35s;

        }

        .hero-btn:hover {

            background: #2f80ed;

            color: white;

            transform: translateY(-5px);

        }

        /* COMMON */

        .section {

            padding: 100px 8%;

        }

        .section-title {

            text-align: center;

            font-size: 2.8rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .divider {

            width: 120px;

            height: 5px;

            background: #2f80ed;

            margin: 0 auto 60px;

            border-radius: 30px;

        }

        /* INTRO */

        .intro {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 60px;

            align-items: center;

        }

        .intro img {

            width: 100%;

            border-radius: 20px;

            box-shadow: 0 15px 35px rgba(0, 0, 0, .15);

        }

        .intro-content h2 {

            font-size: 2.5rem;

            margin-bottom: 20px;

        }

        .intro-content p {

            line-height: 2;

            color: #666;

            margin-bottom: 20px;

        }

        /* OCCASIONS */

        .occasion-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .occasion-card {

            background: white;

            padding: 35px;

            text-align: center;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .occasion-card:hover {

            transform: translateY(-10px);

        }

        .occasion-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .occasion-card h3 {

            margin-bottom: 15px;

        }

        .occasion-card p {

            line-height: 1.8;

            color: #666;

        }

        /* Animation */

        @keyframes fadeUp {

            from {

                opacity: 0;

                transform: translateY(50px);

            }

            to {

                opacity: 1;

                transform: translateY(0);

            }

        }

        @media(max-width:992px) {

            .hero-content h1 {

                font-size: 2.8rem;

            }

            .intro {

                grid-template-columns: 1fr;

            }

        }

        /* Gift Cards */

        .gift-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));

            gap: 35px;

        }

        .gift-card {

            background: white;

            padding: 40px;

            border-radius: 22px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            position: relative;

            transition: .35s;

            overflow: hidden;

        }

        .gift-card:hover {

            transform: translateY(-12px);

        }

        .gift-banner {

            font-size: 2.2rem;

            font-weight: 700;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .gift-card h3 {

            font-weight: 700;

            margin-bottom: 15px;

        }

        .gift-card p {

            color: #666;

            line-height: 1.9;

            margin-bottom: 20px;

        }

        .gift-card ul {

            list-style: none;

            padding: 0;

            margin-bottom: 30px;

        }

        .gift-card li {

            margin-bottom: 12px;

        }

        .gift-card li i {

            color: #2f80ed;

            margin-right: 10px;

        }

        .gift-btn {

            display: inline-block;

            padding: 14px 30px;

            background: #2f80ed;

            color: white;

            text-decoration: none;

            border-radius: 40px;

            font-weight: 600;

            transition: .3s;

        }

        .gift-btn:hover {

            background: #111;

            color: white;

        }

        .popular {

            border: 3px solid #2f80ed;

        }

        .popular-tag {

            position: absolute;

            top: 20px;

            right: -35px;

            background: #ff9800;

            color: white;

            padding: 8px 40px;

            transform: rotate(45deg);

            font-size: .75rem;

            font-weight: 700;

        }

        /* Features */

        .feature-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .feature-card {

            background: #f8f9fc;

            padding: 35px;

            border-radius: 20px;

            text-align: center;

            transition: .35s;

        }

        .feature-card:hover {

            transform: translateY(-10px);

        }

        .feature-card i {

            font-size: 48px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .feature-card h4 {

            margin-bottom: 15px;

            font-weight: 700;

        }

        .feature-card p {

            line-height: 1.8;

            color: #666;

        }

        /* Steps */

        .steps-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));

            gap: 30px;

        }

        .step-card {

            background: white;

            padding: 35px;

            text-align: center;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .step-card:hover {

            transform: translateY(-10px);

        }

        .step-number {

            width: 70px;

            height: 70px;

            background: #2f80ed;

            color: white;

            font-size: 28px;

            font-weight: 700;

            display: flex;

            justify-content: center;

            align-items: center;

            border-radius: 50%;

            margin: 0 auto 20px;

        }

        /* Preview */

        .preview-wrapper {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 70px;

            align-items: center;

        }

        .gift-preview {

            background: linear-gradient(135deg, #2f80ed, #56ccf2);

            color: white;

            padding: 45px;

            border-radius: 25px;

            box-shadow: 0 20px 40px rgba(0, 0, 0, .18);

        }

        .gift-logo {

            font-size: 1.3rem;

            font-weight: 700;

            margin-bottom: 40px;

        }

        .gift-price {

            font-size: 3rem;

            font-weight: 800;

            margin-bottom: 20px;

        }

        .gift-footer {

            margin-top: 40px;

            opacity: .9;

        }

        /* Reviews */

        .review-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));

            gap: 30px;

        }

        .review-card {

            background: white;

            padding: 35px;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .review-card:hover {

            transform: translateY(-10px);

        }

        .review-card i {

            font-size: 40px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .review-card p {

            line-height: 1.9;

            color: #666;

            margin-bottom: 25px;

        }

        .review-card h4 {

            font-weight: 700;

            margin-bottom: 5px;

        }

        /* Stats */

        .stats-section {

            background: white;

        }

        .stats-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));

            gap: 30px;

            text-align: center;

        }

        .stats-grid div {

            background: #f8f9fc;

            padding: 40px;

            border-radius: 20px;

            transition: .35s;

        }

        .stats-grid div:hover {

            transform: translateY(-10px);

        }

        .stats-grid h2 {

            font-size: 3rem;

            font-weight: 800;

            color: #2f80ed;

            margin-bottom: 10px;

        }

        @media(max-width:992px) {

            .preview-wrapper {

                grid-template-columns: 1fr;

            }

        }

        /* FAQ */

        .faq-section {

            background: #f7f9fc;

        }

        .accordion-button {

            font-weight: 600;

        }

        /* Terms */

        .terms-box {

            background: #eef5ff;

            padding: 40px;

            border-left: 6px solid #2f80ed;

            border-radius: 20px;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .06);

        }

        .terms-box ul {

            margin: 0;

            padding-left: 20px;

        }

        .terms-box li {

            margin-bottom: 18px;

            line-height: 1.9;

        }

        /* Corporate */

        .corporate-card {

            background: white;

            padding: 50px;

            text-align: center;

            border-radius: 25px;

            box-shadow: 0 12px 30px rgba(0, 0, 0, .08);

        }

        .corporate-card i {

            font-size: 60px;

            color: #2f80ed;

            margin-bottom: 25px;

        }

        .corporate-card h3 {

            font-weight: 700;

            margin-bottom: 20px;

        }

        .corporate-card p {

            line-height: 2;

            color: #666;

            margin-bottom: 35px;

        }

        /* CTA */

        .gift-cta {

            padding: 120px 8%;

            background: linear-gradient(135deg, #2f80ed, #56ccf2);

            text-align: center;

            color: white;

        }

        .gift-cta h2 {

            font-size: 3rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .gift-cta p {

            max-width: 750px;

            margin: 0 auto 40px;

            line-height: 2;

        }

        .cta-buttons {

            display: flex;

            justify-content: center;

            gap: 20px;

            flex-wrap: wrap;

        }

        .cta-buttons .btn {

            padding: 16px 35px;

            border-radius: 50px;

            font-weight: 600;

            transition: .3s;

        }

        .cta-buttons .btn:hover {

            transform: translateY(-5px);

        }

        @media(max-width:768px) {

            .gift-cta h2 {

                font-size: 2.2rem;

            }

            .cta-buttons {

                flex-direction: column;

                align-items: center;

            }

            .cta-buttons .btn {

                width: 260px;

            }

        }
    </style>

