    <!-- FAQ -->

    <section class="section faq-section">

        <div class="container">

            <h2 class="section-title">

                Frequently Asked Questions

            </h2>

            <div class="divider"></div>

            <div class="accordion" id="giftFAQ">

                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button" type="button" data-bs-toggle="collapse"
                            data-bs-target="#gift1">

                            How do I redeem my Gift Card?

                        </button>

                    </h2>

                    <div id="gift1" class="accordion-collapse collapse show" data-bs-parent="#giftFAQ">

                        <div class="accordion-body">

                            Enter your Gift Card code during checkout while booking a stay on Homigo. The available
                            balance will automatically be applied to your booking.

                        </div>

                    </div>

                </div>

                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#gift2">

                            Can I use multiple Gift Cards?

                        </button>

                    </h2>

                    <div id="gift2" class="accordion-collapse collapse" data-bs-parent="#giftFAQ">

                        <div class="accordion-body">

