<% layout("layouts/boilerplate") %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        :root {

            --primary: #2f80ed;

            --secondary: #56ccf2;

            --dark: #1d1d1d;

            --light: #f8f9fa;

        }

        * {

            margin: 0;

            padding: 0;

            box-sizing: border-box;

            font-family: 'Poppins', sans-serif;

        }

        body {

            background: #f7f9fc;

            overflow-x: hidden;

        }

        /* Hero */

        .career-hero {

            height: 90vh;

            display: flex;

            align-items: center;

            justify-content: center;

            text-align: center;

            background:

                linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .55)),

                url("https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1800&q=80");

            background-size: cover;

            background-position: center;

            color: white;

        }

        .hero-content {

            max-width: 900px;

            padding: 20px;

            animation: fadeUp 1s ease;

        }

        .hero-content h1 {

            font-size: 4rem;

            font-weight: 800;

            margin-bottom: 20px;

        }

        .hero-content p {

            font-size: 1.15rem;

            line-height: 2;

            color: #eee;

            margin-bottom: 35px;

        }

        .hero-btn {

            display: inline-block;

            padding: 16px 45px;

            background: white;

            color: #2f80ed;

            font-weight: 700;

            text-decoration: none;

            border-radius: 50px;

            transition: .35s;

        }

        .hero-btn:hover {

            background: #2f80ed;

            color: white;

            transform: translateY(-5px);

        }

        /* Sections */

        .section {

            padding: 100px 8%;

        }

        .section-title {

            text-align: center;

            font-size: 2.8rem;

            font-weight: 700;

            margin-bottom: 20px;

            color: #222;

        }

        .divider {

            width: 120px;

            height: 5px;

            background: #2f80ed;

            margin: 0 auto 60px;

            border-radius: 30px;

        }

        /* Culture */

        .culture-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .culture-card {

            background: white;

            padding: 40px;

            border-radius: 20px;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

            text-align: center;

            transition: .35s;

            height: 100%;

        }

        .culture-card:hover {

            transform: translateY(-8px);

        }

        .culture-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .culture-card h3 {

            margin-bottom: 18px;

            font-weight: 700;

        }

        .culture-card p {

            color: #666;

            line-height: 1.8;

        }

        /* Why Join */

        .join-wrapper {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 60px;

            align-items: center;

        }

        .join-wrapper img {

            width: 100%;

            border-radius: 20px;

            box-shadow: 0 15px 40px rgba(0, 0, 0, .12);

        }

        .join-content h2 {

            font-size: 2.5rem;

            margin-bottom: 20px;

            font-weight: 700;

        }

        .join-content p {

            line-height: 2;

            color: #666;

            margin-bottom: 20px;

        }

        .join-list {

            list-style: none;

            padding: 0;

        }

        .join-list li {

            margin-bottom: 18px;

            font-size: 1.05rem;

        }

        .join-list i {

            color: #2f80ed;

            margin-right: 12px;

        }

        /* Animation */

        @keyframes fadeUp {

            from {

                opacity: 0;

                transform: translateY(50px);

            }

            to {

                opacity: 1;

                transform: translateY(0);

            }

        }

        @media(max-width:992px) {

            .hero-content h1 {

                font-size: 2.8rem;

            }

            .join-wrapper {

                grid-template-columns: 1fr;

            }

        }

        /* Jobs */

        .jobs-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));

            gap: 35px;

        }

        .job-card {

            background: white;

            padding: 35px;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

            position: relative;

        }

        .job-card:hover {

            transform: translateY(-10px);

        }

        .job-type {

            background: #2f80ed;

            color: white;

            padding: 6px 15px;

            border-radius: 30px;

            font-size: .8rem;

            font-weight: 600;

            display: inline-block;

            margin-bottom: 20px;

        }

        .job-card h3 {

            font-weight: 700;

            margin-bottom: 15px;

        }

        .location {

            color: #2f80ed;

            font-weight: 600;

            margin-bottom: 20px;

        }

        .skills {

            display: flex;

            flex-wrap: wrap;

            gap: 10px;

            margin: 25px 0;

        }

        .skills span {

            background: #eef5ff;

            padding: 8px 14px;

            border-radius: 30px;

            font-size: .85rem;

        }

        .apply-btn {

            display: inline-block;

            padding: 12px 30px;

            background: #2f80ed;

            color: white;

            text-decoration: none;

            border-radius: 40px;

            transition: .3s;

            font-weight: 600;

        }

        .apply-btn:hover {

            background: #111;

            color: white;

        }

        /* Benefits */

        .benefits-section {

            background: white;

        }

        .benefits-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .benefit-card {

            padding: 35px;

            background: #f8f9fc;

            border-radius: 20px;

            text-align: center;

            transition: .35s;

        }

        .benefit-card:hover {

            transform: translateY(-8px);

        }

        .benefit-card i {

            font-size: 45px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        /* Stats */

        .career-stats {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));

            gap: 25px;

            text-align: center;

        }

        .career-stats div {

            background: white;

            padding: 40px;

            border-radius: 20px;

            box-shadow: 0 8px 25px rgba(0, 0, 0, .06);

            transition: .35s;

        }

        .career-stats div:hover {

            transform: translateY(-8px);

        }

        .career-stats h2 {

            font-size: 3rem;

            font-weight: 700;

            color: #2f80ed;

            margin-bottom: 10px;

        }

        /* Hiring Process */

        .process-section {

            background: #fff;

        }

        .process-wrapper {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));

            gap: 30px;

        }

        .process-step {

            background: #f8f9fc;

            padding: 35px;

            border-radius: 20px;

            text-align: center;

            transition: .35s;

        }

        .process-step:hover {

            transform: translateY(-8px);

        }

        .process-number {

            width: 70px;

            height: 70px;

            margin: auto auto 20px;

            background: #2f80ed;

            color: white;

            font-size: 28px;

            font-weight: 700;

            display: flex;

            justify-content: center;

            align-items: center;

            border-radius: 50%;

        }

        /* Testimonials */

        .testimonial-section {

            background: #f7f9fc;

        }

        .testimonial-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));

            gap: 30px;

        }

        .testimonial-card {

            background: white;

            padding: 35px;

            border-radius: 20px;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .testimonial-card:hover {

            transform: translateY(-8px);

        }

        .testimonial-card i {

            font-size: 35px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .testimonial-card h5 {

            margin-top: 20px;

            margin-bottom: 5px;

            font-weight: 700;

        }

        .testimonial-card span {

            color: #777;

        }

        /* FAQ */

        .faq-section {

            background: white;

        }

        .accordion-button {

            font-weight: 600;

        }

        /* CTA */

        .career-cta {

            padding: 120px 8%;

            text-align: center;

            background: linear-gradient(135deg, #2f80ed, #56ccf2);

            color: white;

        }

        .career-cta h2 {

            font-size: 3rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .career-cta p {

            max-width: 700px;

            margin: auto auto 35px;

            line-height: 2;

        }

        .career-btn {

            display: inline-block;

            padding: 16px 45px;

            background: white;

            color: #2f80ed;

            text-decoration: none;

            border-radius: 50px;

            font-weight: 700;

            transition: .3s;

        }

        .career-btn:hover {

            background: #111;

            color: white;

        }

        /* Awards */

        .awards-section {

            background: white;

        }

        .award-card {

            padding: 40px;

            text-align: center;

            border-radius: 20px;

            background: #f8f9fc;

            transition: .35s;

            box-shadow: 0 8px 25px rgba(0, 0, 0, .06);

        }

        .award-card:hover {

            transform: translateY(-10px);

        }

        .award-card i {

            font-size: 55px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        /* Offices */

        .office-section {

            background: #f7f9fc;

        }

        .office-card {

            padding: 40px;

            background: white;

            border-radius: 20px;

            text-align: center;

            transition: .35s;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .06);

        }

        .office-card:hover {

            transform: translateY(-10px);

        }

        .office-card i {

            font-size: 55px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        /* Gallery */

        .gallery-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));

            gap: 20px;

        }

        .gallery-grid img {

            width: 100%;

            height: 250px;

            object-fit: cover;

            border-radius: 20px;

            transition: .4s;

            box-shadow: 0 8px 25px rgba(0, 0, 0, .08);

        }

        .gallery-grid img:hover {

            transform: scale(1.05);

        }
    </style>

