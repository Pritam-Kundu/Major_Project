                <h3>

                    Secure Devices

                </h3>

                <p>

                    Keep your browser,
                    mobile apps,
                    and operating system updated.

                </p>

            </div>

            <div class="digital-card">

                <i class="fa-solid fa-wifi"></i>

                <h3>

                    Public Wi-Fi

                </h3>

                <p>

                    Avoid making sensitive payments over unsecured public Wi-Fi networks.

                </p>

            </div>

            <div class="digital-card">

                <i class="fa-solid fa-bug"></i>

                <h3>

                    Stay Alert

                </h3>

                <p>

                    Watch for phishing attempts,
                    fake login pages,
                    and suspicious emails.

                </p>

            </div>

        </div>

    </section>

