    <!-- FAQ -->

    <section class="section faq-section">

        <div class="container">

            <h2 class="section-title">

                Frequently Asked Questions

            </h2>

            <div class="divider"></div>

            <div class="accordion" id="safetyFAQ">

                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">

                            How can I verify a property before booking?

                        </button>

                    </h2>

                    <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#safetyFAQ">

                        <div class="accordion-body">

                            Read the listing description carefully, review photos, amenities, house rules, and previous
                            guest reviews before confirming your reservation.

                        </div>

                    </div>

                </div>

                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#faq2">

                            What should I do if I receive a suspicious payment request?

                        </button>

                    </h2>

                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#safetyFAQ">

                        <div class="accordion-body">

                            Never send payments outside Homigo. Report any suspicious payment requests or unusual
                            activity immediately through our Help Center.

                        </div>

                    </div>

                </div>

                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#faq3">

                            Who should I contact in an emergency?

                        </button>

                    </h2>

                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#safetyFAQ">

                        <div class="accordion-body">

                            If you are facing an emergency, contact your local emergency services immediately. For
