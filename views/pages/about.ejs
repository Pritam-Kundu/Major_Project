<% layout("layouts/boilerplate") %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        :root {
            --primary: #2f80ed;
            --secondary: #56ccf2;
            --dark: #1d1d1d;
            --light: #f8f9fa;
            --text: #555;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f8f9fa;
            overflow-x: hidden;
        }

        /* Hero */

        .about-hero {

            position: relative;

            width: 100%;

            height: 90vh;

            background:
                linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .55)),
                url("https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1800&q=80");

            background-size: cover;

            background-position: center;

            display: flex;

            align-items: center;

            justify-content: center;

            text-align: center;

            color: white;

        }

        .about-content {

            max-width: 900px;

            animation: fadeUp 1s ease;

        }

        .about-content h1 {

            font-size: 4rem;

            font-weight: 800;

            margin-bottom: 20px;

        }

        .about-content p {

            font-size: 1.2rem;

            line-height: 1.8;

            color: #eee;

            margin-bottom: 35px;

        }

        .about-btn {

            display: inline-block;

            padding: 16px 40px;

            background: #fff;

            color: #222;

            border-radius: 50px;

            text-decoration: none;

            font-weight: 600;

            transition: .35s;

        }

        .about-btn:hover {

            transform: translateY(-5px);

            background: #2f80ed;

            color: #fff;

        }

        /* Intro */

        .intro {

            padding: 90px 8%;

            background: white;

        }

        .section-title {

            font-size: 2.8rem;

            text-align: center;

            margin-bottom: 25px;

            font-weight: 700;

            color: #222;

        }

        .section-text {

            text-align: center;

            max-width: 950px;

            margin: auto;

            color: #666;

            line-height: 2;

            font-size: 1.05rem;

        }

        /* Stats */

        .stats {

            padding: 70px 8%;

            background: #f5f7fb;

        }

        .stats-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));

            gap: 30px;

        }

        .stat-card {

            background: white;

            border-radius: 18px;

            text-align: center;

            padding: 40px;

            transition: .35s;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .06);

        }

        .stat-card:hover {

            transform: translateY(-8px);

        }

        .stat-card i {

            font-size: 3rem;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .stat-card h2 {

            font-size: 2.7rem;

            color: #222;

            margin-bottom: 10px;

        }

        .stat-card p {

            color: #777;

            font-weight: 500;

        }


        /* Section Divider */

        .divider {

            width: 120px;

            height: 5px;

            background: #2f80ed;

            margin: 25px auto 50px;

            border-radius: 50px;

        }

        /* Animation */

        @keyframes fadeUp {

            from {

                opacity: 0;

                transform: translateY(60px);

            }

            to {

                opacity: 1;

                transform: translateY(0);

            }

        }

        @media(max-width:768px) {

            .about-content h1 {

                font-size: 2.5rem;

            }

            .about-content p {

                font-size: 1rem;

            }

            .section-title {

                font-size: 2rem;

            }

        }

        /* Story */

        .story-section {

            padding: 90px 8%;

            background: white;

        }

        .story-text {

            font-size: 1rem;

            line-height: 2;

            color: #666;

            margin-bottom: 20px;

        }

        /* Mission */

        .mission-section {

            padding: 90px 8%;

            background: #f5f7fb;

        }

        .mission-card {

            background: white;

            padding: 45px;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            height: 100%;

            transition: .35s;

        }

        .mission-card:hover {

            transform: translateY(-8px);

        }

        .mission-icon {

            width: 75px;

            height: 75px;

            background: #2f80ed;

            border-radius: 50%;

            display: flex;

            justify-content: center;

            align-items: center;

            margin-bottom: 25px;

        }

        .mission-icon i {

            font-size: 30px;

            color: white;

        }

        .mission-card h3 {

            font-weight: 700;

            margin-bottom: 20px;

        }

        .mission-card p {

            line-height: 2;

            color: #666;

        }

        /* Values */

        .values-section {

            padding: 90px 8%;

            background: white;

        }

        .value-card {

            background: #fff;

            padding: 40px 30px;

            border-radius: 20px;

            text-align: center;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .06);

            transition: .35s;

            height: 100%;

            display: flex;

            flex-direction: column;

            align-items: center;

        }

        .value-card:hover {

            transform: translateY(-8px);

        }

        .value-card i {

            font-size: 45px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .value-card h4 {

            font-weight: 700;

            margin-bottom: 15px;

        }

        .value-card p {

            color: #666;

            line-height: 1.8;

        }

        /* Features */

        .features-section {

            padding: 100px 8%;

            background: #f5f7fb;

        }

        .feature-card {

            background: white;

            padding: 40px;

            border-radius: 20px;

            height: 100%;

            text-align: center;

            transition: .35s;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .06);

        }

        .feature-card:hover {

            transform: translateY(-10px);

        }

        .feature-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .feature-card h4 {

            font-weight: 700;

            margin-bottom: 15px;

        }

        .feature-card p {

            line-height: 1.8;

            color: #666;

        }

        /* Timeline */

        .timeline-section {

            padding: 100px 8%;

            background: white;

        }

        .timeline {

            max-width: 900px;

            margin: auto;

        }

        .timeline-item {

            display: flex;

            gap: 25px;

            margin-bottom: 40px;

            align-items: flex-start;

        }

        .timeline-icon {

            min-width: 70px;

            height: 70px;

            background: #2f80ed;

            border-radius: 50%;

            display: flex;

            justify-content: center;

            align-items: center;

        }

        .timeline-icon i {

            color: white;

            font-size: 30px;

        }

        .timeline-content {

            padding-top: 8px;

        }

        .timeline-content h4 {

            font-weight: 700;

            margin-bottom: 12px;

        }

        .timeline-content p {

            line-height: 1.8;

            color: #666;

        }

        /* Team */

        .team-section {

            padding: 100px 8%;

            background: #f5f7fb;

        }

        .team-intro {

            max-width: 850px;

            margin: 0 auto 60px;

            text-align: center;

            font-size: 1.08rem;

            line-height: 1.8;

            color: #666;

        }

        .team-grid {

            display: flex;

            justify-content: center;

            gap: 50px;

            flex-wrap: wrap;

        }

        .team-card {

            width: 420px;

            background: #fff;

            padding: 40px;

            border-radius: 25px;

            text-align: center;

            box-shadow: 0 15px 35px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .team-card:hover {

            transform: translateY(-10px);

            box-shadow: 0 25px 50px rgba(0, 0, 0, .15);

        }

        .team-img {

            width: 170px;

            height: 170px;

            object-fit: cover;

            border-radius: 50%;

            border: 5px solid #2f80ed;

            margin-bottom: 25px;

        }

        .team-card h3 {

            font-size: 2rem;

            margin-bottom: 10px;

            font-weight: 700;

        }

        .team-role {

            display: inline-block;

            color: #2f80ed;

            font-weight: 600;

            margin-bottom: 20px;

            font-size: 1.05rem;

        }

        .team-card p {

            color: #555;

            line-height: 1.9;

        }

        @media(max-width:992px) {

            .team-card {

                width: 100%;

                max-width: 420px;

            }

        }

        /* Achievement */

        .achievement-section {

            padding: 100px 8%;

            background: white;

        }

        .achievement-card {

            background: #f8f9fa;

            padding: 45px;

            border-radius: 20px;

            transition: .35s;

            box-shadow: 0 8px 25px rgba(0, 0, 0, .05);

        }

        .achievement-card:hover {

            transform: translateY(-10px);

        }

        .achievement-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .achievement-card h3 {

            font-size: 2.5rem;

            font-weight: 700;

            margin-bottom: 10px;

        }

        .achievement-card p {

            color: #666;

        }

        /* Newsletter */

        .newsletter-section {

            padding: 100px 8%;

            background: linear-gradient(135deg, #2f80ed, #56ccf2);

            text-align: center;

            color: white;

        }

        .newsletter-section h2 {

            font-size: 2.8rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .newsletter-section p {

            max-width: 700px;

            margin: auto auto 40px;

            line-height: 1.8;

        }

        .newsletter-form {

            display: flex;

            justify-content: center;

            gap: 15px;

            flex-wrap: wrap;

        }

        .newsletter-form input {

            width: 420px;

            max-width: 100%;

            padding: 16px;

            border: none;

            border-radius: 50px;

            outline: none;

        }

        .newsletter-form button {

            padding: 16px 35px;

            border: none;

            border-radius: 50px;

            background: white;

            color: #2f80ed;

            font-weight: 700;

            transition: .3s;

        }

        .newsletter-form button:hover {

            background: #222;

            color: white;

        }

        /* CTA */

        .cta-section {

            padding: 120px 8%;

            background: #111;

            color: white;

            text-align: center;

        }

        .cta-section h2 {

            font-size: 3rem;

            font-weight: 700;

            margin-bottom: 25px;

        }

        .cta-section p {

            max-width: 800px;

            margin: auto auto 40px;

            line-height: 2;

            color: #ddd;

        }

        .cta-btn {

            display: inline-block;

            padding: 18px 45px;

            background: #2f80ed;

            color: white;

            text-decoration: none;

            border-radius: 50px;

            font-weight: 600;

            transition: .35s;

        }

        .cta-btn:hover {

            background: #56ccf2;

            transform: translateY(-5px);

        }

        /* Animation */

        .feature-card,
        .value-card,
        .team-card,
        .stat-card,
        .achievement-card,
        .mission-card {

            transition: all .35s ease;

        }

        img {

            transition: .4s;

        }

        img:hover {

            transform: scale(1.03);

        }

        @media(max-width:768px) {

            .newsletter-form {

                flex-direction: column;

            }

            .newsletter-form input {

                width: 100%;

            }

            .about-content h1 {

                font-size: 2.4rem;

            }

            .cta-section h2 {

                font-size: 2rem;

            }

            .newsletter-section h2 {

                font-size: 2rem;

            }

        }
    </style>

    <!-- HERO -->

    <section class="about-hero">

        <div class="about-content">

            <h1>Discover the World with Homigo</h1>

            <p>

                Homigo is more than a booking platform.

                We connect travelers with memorable stays, premium experiences,
                and trusted hosts across the globe.

                From luxury resorts to cozy homestays,
                our mission is to make every journey effortless,
                secure and unforgettable.

            </p>

            <a href="/listings" class="about-btn">

                Explore Properties

            </a>

        </div>

    </section>

    <!-- INTRO -->

    <section class="intro">

        <h2 class="section-title">

            Welcome to Homigo

        </h2>

        <div class="divider"></div>

        <p class="section-text">

            At Homigo, we believe that travel is more than simply reaching a destination—
            it's about discovering new cultures, creating lifelong memories,
            and feeling at home wherever you go.

            Our platform brings together carefully verified properties,
            secure payment systems, and exceptional customer support,
            making every booking experience simple, transparent, and stress-free.

            Whether you're planning a family vacation,
            a romantic getaway,
            a business trip,
            or a solo adventure,
            Homigo helps you find the perfect place to stay.

        </p>

    </section>

