    <!-- TEAM -->

    <section class="team-section">

        <div class="container">

            <h2 class="section-title">

                Meet Our Team

            </h2>

            <div class="divider"></div>

            <p class="team-intro">
                Homigo was designed and developed as a collaborative project by two passionate developers dedicated to
                creating a modern and reliable hotel booking platform.
            </p>

            <div class="team-grid">

                <!-- Pritam -->

                <div class="team-card">

                    <img src="/images/team/Pritam.jpeg" alt="Pritam Kundu" class="team-img">

                    <h3>Pritam Kundu</h3>

                    <span class="team-role">
