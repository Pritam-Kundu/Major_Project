<% layout("layouts/boilerplate") %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f7f9fc;
            overflow-x: hidden;
        }

        /* Hero */

        .blog-hero {

            height: 90vh;

            display: flex;

            justify-content: center;

            align-items: center;

            text-align: center;

            color: white;

            background:

                linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .55)),

                url("https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1800&q=80");

            background-size: cover;

            background-position: center;

        }

        .hero-content {

            max-width: 850px;

            padding: 20px;

        }

        .hero-content h1 {

            font-size: 4rem;

            font-weight: 800;

            margin-bottom: 20px;

        }

        .hero-content p {

            font-size: 1.15rem;

            line-height: 2;

            margin-bottom: 35px;

            color: #eee;

        }

        .search-box {

            display: flex;

            justify-content: center;

            gap: 15px;

            flex-wrap: wrap;

        }

        .search-box input {

            width: 420px;

            max-width: 100%;

            padding: 16px;

            border: none;

            border-radius: 50px;

            outline: none;

        }

        .search-box button {

            padding: 16px 35px;

            border: none;

            border-radius: 50px;

            background: #2f80ed;

            color: white;

            font-weight: 700;

            transition: .3s;

        }

        .search-box button:hover {

            background: #111;

        }

        /* Common */

        .section {

            padding: 100px 8%;

        }

        .section-title {

            text-align: center;

            font-size: 2.8rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .divider {

            width: 120px;

            height: 5px;

            background: #2f80ed;

            margin: 0 auto 60px;

            border-radius: 30px;

        }

        /* Categories */

        .categories {

            display: flex;

            justify-content: center;

            gap: 20px;

            flex-wrap: wrap;

        }

        .category {

            padding: 14px 28px;

            background: white;

            border-radius: 40px;

            box-shadow: 0 6px 18px rgba(0, 0, 0, .08);

            transition: .3s;

            cursor: pointer;

            font-weight: 600;

        }

        .category:hover {

            background: #2f80ed;

            color: white;

        }

        /* Featured */

        .featured {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 60px;

            align-items: center;

        }

        .featured img {

            width: 100%;

            border-radius: 20px;

            box-shadow: 0 15px 35px rgba(0, 0, 0, .12);

        }

        .featured h2 {

            font-size: 2.5rem;

            margin-bottom: 20px;

        }

        .featured p {

            line-height: 2;

            color: #666;

            margin-bottom: 30px;

        }

        .read-btn {

            display: inline-block;

            padding: 14px 35px;

            background: #2f80ed;

            color: white;

            text-decoration: none;

            border-radius: 40px;

            font-weight: 600;

            transition: .3s;

        }

        .read-btn:hover {

            background: #111;

            color: white;

        }

        @media(max-width:992px) {

            .hero-content h1 {

                font-size: 2.7rem;

            }

            .featured {

                grid-template-columns: 1fr;

            }

        }

        /* Articles */

        .article-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));

            gap: 35px;

        }

        .article-card {

            background: white;

            border-radius: 20px;

            overflow: hidden;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .article-card:hover {

            transform: translateY(-10px);

        }

        .article-card img {

            width: 100%;

            height: 230px;

            object-fit: cover;

        }

        .article-body {

            padding: 30px;

        }

        .article-category {

            background: #2f80ed;

            color: white;

            padding: 6px 14px;

            border-radius: 30px;

            font-size: .8rem;

        }

        .article-body h3 {

            margin: 20px 0;

            font-size: 1.5rem;

        }

        .article-body p {

            line-height: 1.8;

            color: #666;

        }

        .article-link {

            display: inline-block;

            margin-top: 20px;

            font-weight: 600;

            text-decoration: none;

        }

        /* Destinations */

        .destination-section {

            background: white;

        }

        .destination-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 25px;

        }

        .destination-card {

            position: relative;

            overflow: hidden;

            border-radius: 20px;

            cursor: pointer;

        }

        .destination-card img {

            width: 100%;

            height: 350px;

            object-fit: cover;

            transition: .4s;

        }

        .destination-card:hover img {

            transform: scale(1.08);

        }

        .destination-overlay {

            position: absolute;

            left: 0;

            bottom: 0;

            width: 100%;

            padding: 30px;

            background: linear-gradient(transparent, rgba(0, 0, 0, .8));

            color: white;

        }

        /* Editor */

        .editor-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));

            gap: 30px;

        }

        .editor-card {

            background: #fff;

            padding: 35px;

            border-radius: 20px;

            text-align: center;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .editor-card:hover {

            transform: translateY(-10px);

        }

        .editor-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        /* Travel Tips */

        .tips-section {

            background: #fff;

        }

        .tips-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .tip-card {

            background: #f8f9fc;

            padding: 35px;

            border-radius: 20px;

            text-align: center;

            transition: .35s;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .06);

        }

        .tip-card:hover {

            transform: translateY(-10px);

        }

        .tip-card i {

            font-size: 48px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .tip-card p {

            line-height: 1.8;

            color: #666;

        }

        /* Gallery */

        .gallery-section {

            background: #f7f9fc;

        }

        .gallery-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));

            gap: 20px;

        }

        .gallery-grid img {

            width: 100%;

            height: 240px;

            object-fit: cover;

            border-radius: 20px;

            transition: .4s;

            box-shadow: 0 8px 20px rgba(0, 0, 0, .08);

        }

        .gallery-grid img:hover {

            transform: scale(1.05);

        }

        /* Newsletter */

        .newsletter {

            padding: 100px 8%;

            background: linear-gradient(135deg, #2f80ed, #56ccf2);

            color: white;

            text-align: center;

        }

        .newsletter h2 {

            font-size: 2.8rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .newsletter p {

            max-width: 700px;

            margin: 0 auto 35px;

            line-height: 2;

        }

        .newsletter-form {

            display: flex;

            justify-content: center;

            gap: 15px;

            flex-wrap: wrap;

        }

        .newsletter-form input {

            width: 420px;

            max-width: 100%;

            padding: 16px;

            border: none;

            border-radius: 50px;

            outline: none;

        }

        .newsletter-form button {

            padding: 16px 35px;

            border: none;

            border-radius: 50px;

            background: white;

            color: #2f80ed;

            font-weight: 700;

            cursor: pointer;

            transition: .3s;

        }

        .newsletter-form button:hover {

            background: #111;

            color: white;

        }

        /* CTA */

        .blog-cta {

            padding: 120px 8%;

            text-align: center;

            background: #111;

            color: white;

        }

        .blog-cta h2 {

            font-size: 3rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .blog-cta p {

            max-width: 750px;

            margin: 0 auto 35px;

            line-height: 2;

            color: #ddd;

        }

        .cta-btn {

            display: inline-block;

            padding: 16px 40px;

            background: #2f80ed;

            color: white;

            text-decoration: none;

            border-radius: 50px;

            font-weight: 600;

            transition: .3s;

        }

        .cta-btn:hover {

            background: #56ccf2;

            color: white;

            transform: translateY(-5px);

        }

        @media(max-width:768px) {

            .newsletter h2 {

                font-size: 2rem;

            }

            .blog-cta h2 {

                font-size: 2.2rem;

            }

            .newsletter-form {

                flex-direction: column;

            }

            .newsletter-form input {

                width: 100%;

            }

        }
    </style>

