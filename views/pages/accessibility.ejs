<% layout("layouts/boilerplate") %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f8f9fc;
            overflow-x: hidden;
        }

        /* HERO */

        .accessibility-hero {

            height: 80vh;

            display: flex;

            justify-content: center;

            align-items: center;

            text-align: center;

            color: white;

            background:
                linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .55)),
                url("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1800&q=80");

            background-size: cover;

            background-position: center;

        }

        .hero-content {

            max-width: 900px;

            padding: 20px;

            animation: fadeUp 1s ease;

        }

        .hero-content h1 {

            font-size: 4rem;

            font-weight: 800;

            margin-bottom: 20px;

        }

        .hero-content p {

            font-size: 1.15rem;

            line-height: 2;

            color: #eee;

        }

        /* COMMON */

        .section {

            padding: 100px 8%;

        }

        .section-title {

            text-align: center;

            font-size: 2.8rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .divider {

            width: 120px;

            height: 5px;

            background: #2f80ed;

            margin: 0 auto 60px;

            border-radius: 30px;

        }

        /* OVERVIEW */

        .overview {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 60px;

            align-items: center;

        }

        .overview img {

            width: 100%;

            border-radius: 20px;

            box-shadow: 0 15px 35px rgba(0, 0, 0, .15);

        }

        .overview-content h2 {

            font-size: 2.5rem;

            margin-bottom: 20px;

        }

        .overview-content p {

            line-height: 2;

            color: #666;

            margin-bottom: 20px;

        }

        /* FEATURE GRID */

        .feature-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .feature-card {

            background: white;

            padding: 35px;

            text-align: center;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .feature-card:hover {

            transform: translateY(-10px);

        }

        .feature-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .feature-card h3 {

            margin-bottom: 15px;

            font-weight: 700;

        }

        .feature-card p {

            line-height: 1.9;

            color: #666;

        }

        @keyframes fadeUp {

            from {

                opacity: 0;

                transform: translateY(40px);

            }

            to {

                opacity: 1;

                transform: translateY(0);

            }

        }

        @media(max-width:992px) {

            .hero-content h1 {

                font-size: 2.8rem;

            }

            .overview {

                grid-template-columns: 1fr;

            }

        }

        /* Website */

        .website-wrapper {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 60px;

            align-items: center;

        }

        .website-content h2 {

            margin-bottom: 20px;

            font-weight: 700;

        }

        .website-content p {

            line-height: 2;

            color: #666;

            margin-bottom: 20px;

        }

        .website-content ul {

            list-style: none;

            padding: 0;

        }

        .website-content li {

            margin-bottom: 18px;

        }

        .website-content li i {

            color: #2f80ed;

            margin-right: 10px;

        }

        /* Property Cards */

        .accessibility-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .accessibility-card {

            background: white;

            padding: 35px;

            text-align: center;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .accessibility-card:hover {

            transform: translateY(-10px);

        }

        .accessibility-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        /* Mobile */

        .mobile-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .mobile-card {

            background: white;

            padding: 35px;

            text-align: center;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .mobile-card:hover {

            transform: translateY(-10px);

        }

        .mobile-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        /* Improvement */

        .improvement-section {

            background: white;

        }

        .improvement-box {

            display: flex;

            gap: 30px;

            background: #eef5ff;

            padding: 40px;

            border-left: 6px solid #2f80ed;

            border-radius: 20px;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

        }

        .improvement-icon i {

            font-size: 60px;

            color: #2f80ed;

        }

        @media(max-width:992px) {

            .website-wrapper {

                grid-template-columns: 1fr;

            }

            .improvement-box {

                flex-direction: column;

            }

        }

        /* Standards */

        .standard-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

            gap: 30px;

        }

        .standard-card {

            background: white;

            padding: 35px;

            border-radius: 20px;

            text-align: center;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .standard-card:hover {

            transform: translateY(-10px);

        }

        .standard-card i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        /* Principles */

        .principle-wrapper {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 60px;

            align-items: center;

        }

        .principle-content h2 {

            margin-bottom: 20px;

            font-weight: 700;

        }

        .principle-content p {

            line-height: 2;

            color: #666;

            margin-bottom: 20px;

        }

        .principle-content ul {

            list-style: none;

            padding: 0;

        }

        .principle-content li {

            margin-bottom: 18px;

        }

        .principle-content i {

            color: #2f80ed;

            margin-right: 10px;

        }

        /* Feedback */

        .feedback-box {

            display: flex;

            gap: 30px;

            background: #eef5ff;

            padding: 40px;

            border-left: 6px solid #2f80ed;

            border-radius: 20px;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

        }

        .feedback-icon i {

            font-size: 60px;

            color: #2f80ed;

        }

        /* Resources */

        .resource-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));

            gap: 25px;

        }

        .resource-card {

            background: white;

            padding: 35px;

            text-align: center;

            border-radius: 20px;

            text-decoration: none;

            color: #333;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .resource-card:hover {

            background: #2f80ed;

            color: white;

            transform: translateY(-10px);

        }

        .resource-card i {

            font-size: 45px;

            margin-bottom: 15px;

        }

        /* Commitment */

        .commitment-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));

            gap: 30px;

        }

        .commitment-card {

            background: white;

            padding: 40px;

            text-align: center;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .commitment-card:hover {

            transform: translateY(-10px);

        }

        .commitment-card h2 {

            font-size: 2.8rem;

            font-weight: 800;

            color: #2f80ed;

            margin-bottom: 10px;

        }

        @media(max-width:992px) {

            .principle-wrapper {

                grid-template-columns: 1fr;

            }

            .feedback-box {

                flex-direction: column;

            }

        }

        /* FAQ */

        .faq-section {

            background: #f8f9fc;

        }

        .accordion-button {

            font-weight: 600;

            font-size: 1.05rem;

        }

        /* Statement */

        .statement-box {

            display: flex;

            gap: 30px;

            align-items: flex-start;

            background: #eef5ff;

            padding: 40px;

            border-left: 6px solid #2f80ed;

            border-radius: 20px;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

        }

        .statement-box i {

            font-size: 60px;

            color: #2f80ed;

            margin-top: 5px;

        }

        .statement-box h3 {

            font-weight: 700;

            margin-bottom: 15px;

        }

        .statement-box p {

            line-height: 1.9;

            color: #555;

        }

        /* Last Updated */

        .last-update {

            max-width: 450px;

            margin: auto;

            background: white;

            padding: 35px;

            border-radius: 20px;

            text-align: center;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

        }

        .last-update i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 15px;

        }

        .last-update h3 {

            font-weight: 700;

            margin-bottom: 10px;

        }

        .last-update p {

            margin: 0;

            font-size: 1.1rem;

            color: #666;

        }

        /* CTA */

        .accessibility-contact {

            padding: 120px 8%;

            background: linear-gradient(135deg, #2f80ed, #56ccf2);

            text-align: center;

            color: white;

        }

        .accessibility-contact h2 {

            font-size: 3rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .accessibility-contact p {

            max-width: 760px;

            margin: 0 auto 40px;

            line-height: 2;

        }

        .contact-buttons {

            display: flex;

            justify-content: center;

            gap: 20px;

            flex-wrap: wrap;

        }

        .contact-buttons .btn {

            padding: 16px 36px;

            border-radius: 50px;

            font-weight: 600;

            transition: .3s;

        }

        .contact-buttons .btn:hover {

            transform: translateY(-5px);

        }

        @media(max-width:768px) {

            .statement-box {

                flex-direction: column;

            }

            .accessibility-contact h2 {

                font-size: 2.2rem;

            }

            .contact-buttons {

                flex-direction: column;

                align-items: center;

            }

            .contact-buttons .btn {

                width: 260px;

            }

        }
    </style>

    <!-- HERO -->

