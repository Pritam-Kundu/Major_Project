<% layout("layouts/boilerplate") %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f8f9fc;
            overflow-x: hidden;
        }

        /* HERO */

        .press-hero {

            height: 80vh;

            display: flex;

            justify-content: center;

            align-items: center;

            text-align: center;

            color: white;

            background:
                linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .55)),
                url("https://images.unsplash.com/photo-1495020689067-958852a7765e?auto=format&fit=crop&w=1800&q=80");

            background-size: cover;

            background-position: center;

        }

        .hero-content {

            max-width: 850px;

            padding: 20px;

            animation: fadeUp 1s ease;

        }

        .hero-content h1 {

            font-size: 4rem;

            font-weight: 800;

            margin-bottom: 20px;

        }

        .hero-content p {

            font-size: 1.15rem;

            line-height: 2;

            color: #eee;

        }

        /* COMMON */

        .section {

            padding: 100px 8%;

        }

        .section-title {

            text-align: center;

            font-size: 2.8rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .divider {

            width: 120px;

            height: 5px;

            background: #2f80ed;

            margin: 0 auto 60px;

            border-radius: 30px;

        }

        /* INTRO */

        .press-intro {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 60px;

            align-items: center;

        }

        .press-intro img {

            width: 100%;

            border-radius: 20px;

            box-shadow: 0 15px 35px rgba(0, 0, 0, .15);

        }

        .press-content h2 {

            font-size: 2.5rem;

            margin-bottom: 20px;

        }

        .press-content p {

            line-height: 2;

            color: #666;

            margin-bottom: 20px;

        }

        /* NEWS */

        .news-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));

            gap: 30px;

        }

        .news-card {

            background: white;

            padding: 35px;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .news-card:hover {

            transform: translateY(-10px);

        }

        .news-card i {

            font-size: 48px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .news-card h3 {

            margin-bottom: 15px;

            font-weight: 700;

        }

        .news-card p {

            line-height: 1.9;

            color: #666;

        }

        @keyframes fadeUp {

            from {

                opacity: 0;

                transform: translateY(50px);

            }

            to {

                opacity: 1;

                transform: translateY(0);

            }

        }

        @media(max-width:992px) {

            .hero-content h1 {

                font-size: 2.8rem;

            }

            .press-intro {

                grid-template-columns: 1fr;

            }

        }

        /* Timeline */

        .timeline {

            max-width: 900px;

            margin: auto;

        }

        .timeline-item {

            display: flex;

            gap: 30px;

            margin-bottom: 40px;

            align-items: flex-start;

        }

        .timeline-year {

            min-width: 100px;

            padding: 15px;

            background: #2f80ed;

            color: white;

            text-align: center;

            font-weight: 700;

            border-radius: 12px;

        }

        .timeline-content {

            background: white;

            padding: 30px;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            flex: 1;

        }

        .timeline-content h3 {

            margin-bottom: 15px;

            font-weight: 700;

        }

        .timeline-content p {

            line-height: 1.9;

            color: #666;

        }

        /* Gallery */

        .gallery-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));

            gap: 25px;

        }

        .gallery-grid img {

            width: 100%;

            height: 260px;

            object-fit: cover;

            border-radius: 20px;

            transition: .35s;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

        }

        .gallery-grid img:hover {

            transform: scale(1.05);

        }

        /* Stats */

        .stats-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));

            gap: 30px;

        }

        .stat-card {

            background: white;

            padding: 40px;

            text-align: center;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .stat-card:hover {

            transform: translateY(-10px);

        }

        .stat-card h2 {

            font-size: 3rem;

            font-weight: 800;

            color: #2f80ed;

            margin-bottom: 10px;

        }

        /* Leadership */

        .leader-box {

            max-width: 900px;

            margin: auto;

            background: #eef5ff;

            padding: 50px;

            text-align: center;

            border-radius: 25px;

            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

        }

        .leader-box i {

            font-size: 55px;

            color: #2f80ed;

            margin-bottom: 25px;

        }

        .leader-box p {

            font-size: 1.1rem;

            line-height: 2;

            color: #555;

            margin-bottom: 30px;

        }

        .leader-box h4 {

            font-weight: 700;

            margin-bottom: 5px;

        }

        .leader-box span {

            color: #777;

        }

        @media(max-width:768px) {

            .timeline-item {

                flex-direction: column;

            }

            .timeline-year {

                width: 100px;

            }

        }

        /* Press Releases */

        .release-grid {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));

            gap: 30px;

        }

        .release-card {

            background: white;

            padding: 35px;

            border-radius: 20px;

            box-shadow: 0 10px 30px rgba(0, 0, 0, .08);

            transition: .35s;

        }

        .release-card:hover {

            transform: translateY(-10px);

        }

        .release-date {

            display: inline-block;

            padding: 8px 18px;

            background: #2f80ed;

            color: white;

            border-radius: 30px;

            font-size: .85rem;

            margin-bottom: 20px;

        }

        .release-card h3 {

            font-weight: 700;

            margin-bottom: 18px;

        }

        .release-card p {

            line-height: 1.9;

            color: #666;

            margin-bottom: 20px;

        }

        .read-more {

            font-weight: 600;

            text-decoration: none;

        }

        /* Press Kit */

        .press-kit {

            display: grid;

            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));

            gap: 30px;

        }

        .kit-item {

            background: #f8f9fc;

            padding: 35px;

            border-radius: 20px;

            text-align: center;

            transition: .35s;

        }

        .kit-item:hover {

            transform: translateY(-10px);

        }

        .kit-item i {

            font-size: 50px;

            color: #2f80ed;

            margin-bottom: 20px;

        }

        .kit-item h3 {

            margin-bottom: 15px;

            font-weight: 700;

        }

        .kit-item p {

            line-height: 1.8;

            color: #666;

        }

        /* Contact */

        .press-contact {

            padding: 120px 8%;

            background: linear-gradient(135deg, #2f80ed, #56ccf2);

            text-align: center;

            color: white;

        }

        .press-contact h2 {

            font-size: 3rem;

            font-weight: 700;

            margin-bottom: 20px;

        }

        .press-contact p {

            max-width: 750px;

            margin: 0 auto 40px;

            line-height: 2;

        }

        .contact-buttons {

            display: flex;

            justify-content: center;

            gap: 20px;

            flex-wrap: wrap;

        }

        .contact-buttons .btn {

            padding: 15px 35px;

            border-radius: 50px;

            font-weight: 600;

            transition: .3s;

        }

        .contact-buttons .btn:hover {

            transform: translateY(-5px);

        }

        @media(max-width:768px) {

            .press-contact h2 {

                font-size: 2.2rem;

            }

            .contact-buttons {

                flex-direction: column;

                align-items: center;

            }

            .contact-buttons .btn {

                width: 260px;

            }

        }
    </style>

