<!-- Notification Vanilla JS Logic -->
<% if(currUser){ %>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const notificationList = document.getElementById('notificationList');
      const notificationBadge = document.getElementById('notificationBadge');
      const markAllReadBtn = document.getElementById('markAllReadBtn');
      const clearAllBtn = document.getElementById('clearAllBtn');
      const dropdownToggle = document.getElementById('notificationDropdownToggle');

      let lastLatestNotificationId = null;
      let initialLoad = true;

      function closeDropdown() {
        if (typeof bootstrap !== 'undefined') {
          const bsDropdown = bootstrap.Dropdown.getOrCreateInstance(dropdownToggle);
          bsDropdown.hide();
        }
      }

      function openDropdown() {
        if (typeof bootstrap !== 'undefined') {
          const bsDropdown = bootstrap.Dropdown.getOrCreateInstance(dropdownToggle);
          bsDropdown.show();
        }
      }

      // Format relative time (e.g., "2 minutes ago")
      function getRelativeTime(dateString) {
        const date = new Date(dateString);
        const now = new Date();
        const diffMs = now - date;
        const diffMins = Math.round(diffMs / 60000);
        const diffHrs = Math.round(diffMins / 60);
        const diffDays = Math.round(diffHrs / 24);

        if (diffMins < 1) return 'Just now';
        if (diffMins < 60) return `${diffMins} min${diffMins > 1 ? 's' : ''} ago`;
        if (diffHrs < 24) return `${diffHrs} hr${diffHrs > 1 ? 's' : ''} ago`;
        if (diffDays === 1) return 'Yesterday';
        return `${diffDays} days ago`;
      }

      // Get FontAwesome Icon class based on type
      function getIconClass(type) {
        switch (type) {
          case 'booking': return 'fa-calendar-check';
          case 'payment_success': return 'fa-indian-rupee-sign';
          case 'payment_failed': return 'fa-circle-xmark';
          case 'wishlist': return 'fa-heart';
          case 'review': return 'fa-star';
          case 'listing_update': return 'fa-house-user';
          default: return 'fa-bell';
        }
      }

      async function fetchNotifications() {
        try {
          const res = await fetch('/notifications');
          const data = await res.json();
          if (data.notifications) {
            renderNotifications(data.notifications);
          }
        } catch (err) {
          console.error("Failed to fetch notifications:", err);
        }
      }

      function renderNotifications(notifications) {
        // Auto-open logic: check if the newest notification has changed and is unread
        const currentLatest = notifications[0];
        if (!initialLoad && currentLatest && !currentLatest.isRead) {
          if (lastLatestNotificationId !== currentLatest._id) {
            openDropdown();
            // Automatically close it after 5 seconds
            setTimeout(() => {
              closeDropdown();
            }, 5000);
          }
        }
        if (currentLatest) {
          lastLatestNotificationId = currentLatest._id;
        }
        initialLoad = false;

        if (notifications.length === 0) {
          notificationList.innerHTML = `
          <div class="notification-empty">
            <i class="fa-regular fa-face-smile"></i>
            <p>You're all caught up! No notifications yet.</p>
          </div>
        `;
          notificationBadge.classList.add('d-none');
          return;
        }

        let unreadCount = 0;
        let html = '';

        notifications.forEach(notif => {
          if (!notif.isRead) unreadCount++;

          html += `
          <a href="${notif.link}" class="notification-item ${notif.isRead ? '' : 'unread'}" data-id="${notif._id}">
            <div class="notification-icon-wrapper type-${notif.type}">
              <i class="fa-solid ${getIconClass(notif.type)}"></i>
            </div>
            <div class="notification-content">
              <h6 class="notification-title">${notif.title}</h6>
              <p class="notification-message">${notif.message}</p>
              <p class="notification-time">${getRelativeTime(notif.createdAt)}</p>
            </div>
            <button class="notification-delete" data-id="${notif._id}" title="Delete">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </a>
        `;
        });

        notificationList.innerHTML = html;

        if (unreadCount > 0) {
          notificationBadge.classList.remove('d-none');
        } else {
          notificationBadge.classList.add('d-none');
        }

        // Attach event listeners for marking as read and deleting
        document.querySelectorAll('.notification-item').forEach(item => {
          item.addEventListener('click', async (e) => {
            // If clicked on delete button, let the other listener handle it
            if (e.target.closest('.notification-delete')) {
              e.preventDefault();
              return;
            }

            if (item.classList.contains('unread')) {
              const id = item.getAttribute('data-id');
              await fetch(`/notifications/${id}/read`, { method: 'PUT' });
              item.classList.remove('unread');
              closeDropdown();
              fetchNotifications(); // update badge
            }
          });
        });

        document.querySelectorAll('.notification-delete').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();
            const id = btn.getAttribute('data-id');
            await fetch(`/notifications/${id}`, { method: 'DELETE' });
            fetchNotifications();
          });
        });
      }

      markAllReadBtn.addEventListener('click', async (e) => {
        // Do not stop propagation, let Bootstrap naturally close the dropdown if needed
        await fetch('/notifications/read-all', { method: 'PUT' });
        closeDropdown();
        fetchNotifications();
      });

      clearAllBtn.addEventListener('click', async (e) => {
        // Do not stop propagation, let Bootstrap naturally close the dropdown if needed
        await fetch('/notifications/clear-all', { method: 'DELETE' });
        closeDropdown();
        fetchNotifications();
      });

      // Initial fetch
      fetchNotifications();

      // Poll every 5 seconds to instantly catch new notifications and auto-open
      setInterval(fetchNotifications, 5000);
    });
  </script>
  <% } %>