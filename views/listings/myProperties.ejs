<% layout("layouts/boilerplate") %>

    <div class="container mt-4">

        <h2 class="mb-4">
            My Properties
        </h2>

        <% if(listings.length===0){ %>

            <div class="alert alert-info">

                You haven't listed any property yet.

            </div>

            <a href="/listings/new" class="btn btn-success">

                List Your First Property

            </a>

            <% } else { %>

                <div class="row">

                    <% listings.forEach(listing=>{ %>

                        <div class="col-md-4 mb-4">

                            <div class="card h-100 shadow">

                                <img src="<%= listing.image.url %>" class="card-img-top"
                                    style="height:220px; object-fit:cover;">

                                <div class="card-body">

                                    <h5>
                                        <%= listing.title %>
                                    </h5>

                                    <p>
                                        <%= listing.location %>,
                                            <%= listing.country %>
                                    </p>

                                    <p>

                                        ₹<%= listing.price.toLocaleString("en-IN") %>/night

                                    </p>

                                    <a href="/listings/<%= listing._id %>" class="btn btn-primary">

                                        View

                                    </a>

                                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">

                                        Edit

                                    </a>

                                </div>

                            </div>

                        </div>

                        <% }) %>

                </div>

                <% } %>

    </div>