<% layout("layouts/boilerplate") %>

<style>
  .review-card {
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .review-card:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.13);
    transform: translateY(-3px) scale(1.02);
    background: #fff;
  }
  .review-card .card-title {
    color: #007bff;
  }
  .review-card .btn-outline-danger {
    margin-top: 0.5rem;
  }
  .review-card .card-text::-webkit-scrollbar {
    width: 6px;
  }
  .review-card .card-text::-webkit-scrollbar-thumb {
    background: #e0e0e0;
    border-radius: 4px;
  }
</style>

<body>
  <div class="row mt-3">
    <div class="col-8 offset-3">
      <h3><%= listing.title %></h3>
    </div>

    <div class="card col-6 offset-3 show-card listing-card">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top show-img"
        alt="listing_image"
        frameborder="0"
        style="
          height: 320px;
          width: 100%;
          object-fit: cover;
          border-radius: 1rem 1rem 0 0;
        "
        scrolling="no"
      />
      <div class="card-body">
        <p class="card-text">Owned By: <i><%= listing.owner.username %></i></p>
        <p class="card-text"><%= listing.description %></p>
        <p class="card-text">
          &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
        </p>
        <p class="card-text"><%= listing.location %></p>
        <p class="card-text"><%= listing.country %></p>
      </div>
    </div>

    <br />

    <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
    <div class="btns">
      <a
        href="/listings/<%= listing._id %>/edit"
        class="btn btn-dark col-1 offset-3 edit-btn"
        >Edit</a
      >
    </div>

    <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
      <button class="btn btn-dark col-1 offset-3 mt-2">Delete</button>
    </form>
    <% } %>

    <div class="col-6 offset-3">
      <hr />
      <h4>Leave a Review</h4>

      <form
        method="post"
        action="/listings/<%= listing._id %>/reviews"
        novalidate
        class="needs-validation"
      >
        <!-- <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <input
            type="range"
            class="form-range"
            min="1"
            max="5"
            id="rating"
            name="review[rating]"
          />
        </div> -->

        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating:</label>
          <fieldset class="starability-slot">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />
            <input
              type="radio"
              id="first-rate1"
              name="review[rating]"
              value="1"
            />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input
              type="radio"
              id="first-rate2"
              name="review[rating]"
              value="2"
            />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input
              type="radio"
              id="first-rate3"
              name="review[rating]"
              value="3"
            />
            <label for="first-rate3" title="Average">3 stars</label>
            <input
              type="radio"
              id="first-rate4"
              name="review[rating]"
              value="4"
            />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input
              type="radio"
              id="first-rate5"
              name="review[rating]"
              value="5"
            />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea
            name="review[comment]"
            id="comment"
            cols="30"
            rows="5"
            class="form-control"
            required
          ></textarea>
          <div class="invalid-feedback">Please enter your thoughts here!</div>
        </div>
        <br />
        <button class="btn btn-outline-dark">Submit</button>
        <br />
      </form>

      <hr />

      <p><b>All Reviews</b></p>
      <div
        style="
          max-height: 400px;
          overflow-y: auto;
          overflow-x: hidden;
          padding-right: 8px;
        "
      >
        <div class="row row-cols-1 row-cols-md-3 g-4">
          <% for(let review of listing.reviews){ %>
          <div class="col d-flex">
            <div
              class="card review-card w-100 mb-3"
              style="
                height: 200px;
                min-width: 0;
                max-width: 100%;
                border-radius: 1rem;
                box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
                background: #f8f9fa;
              "
            >
              <div class="card-body d-flex flex-column" style="padding: 1.2rem">
                <div style="margin-bottom: 0.3rem">
                  <h5
                    class="card-title mb-1"
                    style="font-size: 1.05rem; font-weight: 600; color: #222"
                  >
                    @<%= review.author ? review.author.username : "Anonymous" %>
                  </h5>
                  <div>
                    <% for(let i=1; i<=5; i++) { %> <% if(i <= review.rating) {
                    %>
                    <i class="fa-solid fa-star" style="color: #ffd700"></i>
                    <% } else { %>
                    <i class="fa-regular fa-star" style="color: #ffd700"></i>
                    <% } %> <% } %>
                  </div>
                </div>
                <div style="flex: 1; overflow-y: auto; min-height: 0">
                  <p
                    class="card-text"
                    style="
                      font-size: 1rem;
                      color: #333;
                      line-height: 1.4;
                      max-height: 80px;
                      overflow-y: auto;
                      margin-bottom: 0;
                    "
                  >
                    <%= review.comment %>
                  </p>
                </div>
              </div>
              <form
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                class="mb-2"
                method="post"
              >
                <button
                  class="btn btn-sm btn-outline-danger"
                  style="border-radius: 0.7rem"
                >
                  Delete
                </button>
              </form>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</body>
