      font-weight: 700;
      color: #003580;
      margin-bottom: 0.2rem;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .rec-location {
      font-size: 0.85rem;
      color: #0071c2;
      margin-bottom: 0.5rem;
    }
    .rec-stars {
      color: #febb02;
      font-size: 0.8rem;
      margin-bottom: 0.5rem;
    }
    .rec-rating {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 0.8rem;
    }
    .rec-badge {
      background: #003580;
      color: white;
      font-weight: 700;
      padding: 4px 6px;
      border-radius: 4px;
      border-bottom-right-radius: 0;
      font-size: 0.9rem;
    }
    .rec-rating-text {
      font-size: 0.85rem;
      font-weight: 600;
      color: #333;
    }
    .rec-price-section {
      margin-top: auto;
      text-align: right;
    }
    .rec-price {
      font-size: 1.3rem;
      font-weight: 700;
      color: #333;
    }
    .rec-price-tax {
      font-size: 0.75rem;
      color: #666;
    }
