  <!-- You May Also Like Section (Recommendations) -->
  <% if (recommendations && recommendations.length > 0) { %>
    <div class="row mt-5 mb-5">
      <div class="col-12">
        <h3 class="section-title mb-4">You May Also Like</h3>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
          <% for(let rec of recommendations) { 
              let recRatingScore = rec.avgRating ? rec.avgRating.toFixed(1) : "New";
              let recRatingWord = rec.avgRating >= 4.5 ? "Superb" : (rec.avgRating >= 4.0 ? "Fabulous" : (rec.avgRating ? "Good" : "No Reviews"));
              let starCount = rec.avgRating ? Math.round(rec.avgRating) : 5;
              let imageUrl = (rec.image && rec.image.url) ? rec.image.url : (typeof rec.image === 'string' ? rec.image : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=80');
          %>
            <div class="col">
              <a href="/listings/<%= rec._id %>" class="text-decoration-none">
                <div class="rec-card h-100">
                  <div class="rec-img-container">
                    <img src="<%= imageUrl %>" class="rec-img" alt="<%= rec.title %>">
                  </div>
                  <div class="rec-body">
                    <h5 class="rec-title"><%= rec.title %></h5>
                    <div class="rec-stars">
                      <% for(let i=0; i<starCount; i++) { %>
                        <i class="fa-solid fa-star"></i>
                      <% } %>
                    </div>
                    <div class="rec-location text-decoration-underline"><%= rec.location %><% if(rec.country) { %>, <%= rec.country %><% } %></div>
                    <div class="rec-rating">
                      <div class="rec-badge"><%= recRatingScore %></div>
                      <div class="rec-rating-text"><%= recRatingWord %></div>
                    </div>
                    <div class="rec-price-section">
                      <span class="rec-price">₹<%= rec.price.toLocaleString("en-IN") %></span>
                      <div class="rec-price-tax">Per night</div>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script>
    const bookingCard = document.getElementById("bookingCard");
    const price = Number(bookingCard.dataset.price);

    const bookingForm = document.getElementById("bookingForm");
    const checkIn = bookingForm.querySelector("[name='checkIn']");
    const checkOut = bookingForm.querySelector("[name='checkOut']");
    const guests = document.getElementById("guests");
    const rooms = document.getElementById("rooms");

    const total = document.getElementById("totalPrice");
    const totalNights = document.getElementById("totalNights");
    const summaryBlock = document.getElementById("bookingSummaryBlock");

    // Parse booked dates from backend
    const bookedDatesStr = '<%- typeof bookedDates !== "undefined" ? JSON.stringify(bookedDates) : "[]" %>';
    const bookedDates = JSON.parse(bookedDatesStr).map(range => ({
        from: new Date(range.from).toISOString().split('T')[0],
        to: new Date(range.to).toISOString().split('T')[0]
    }));

    // Gallery Scripts
    const displayImagesStr = '<%- typeof displayImages !== "undefined" ? JSON.stringify(displayImages) : "[]" %>';
    const displayImagesArray = JSON.parse(displayImagesStr);
    let currentZoomIndex = 0;
    
    let zoomModal = null;
    let zoomedImage = null;
    let currentScale = 1;

    function resetZoom() {
      currentScale = 1;
      if (zoomedImage) {
        zoomedImage.style.transform = `scale(${currentScale})`;
      }
    }

    function openZoomModal(index) {
      if(!zoomModal) {
         const zoomModalEl = document.getElementById('imageZoomModal');
         if(zoomModalEl && typeof bootstrap !== "undefined") {
            zoomModal = new bootstrap.Modal(zoomModalEl);
         }
      }
      if(!zoomedImage) {
         zoomedImage = document.getElementById('zoomedImage');
         
         // Add wheel event for zooming
         zoomedImage.addEventListener('wheel', (e) => {
           e.preventDefault();
           if (e.deltaY < 0) {
             currentScale = Math.min(currentScale + 0.2, 5); // Max zoom 5x
           } else {
             currentScale = Math.max(currentScale - 0.2, 1); // Min zoom 1x
           }
           zoomedImage.style.transform = `scale(${currentScale})`;
         });
      }

      if(!zoomModal || !zoomedImage) return;

      currentZoomIndex = index;
      zoomedImage.src = displayImagesArray[currentZoomIndex];
      resetZoom();
      zoomModal.show();
    }

    function zoomNext() {
      currentZoomIndex = (currentZoomIndex + 1) % displayImagesArray.length;
      zoomedImage.src = displayImagesArray[currentZoomIndex];
      resetZoom();
    }

    function zoomPrev() {
      currentZoomIndex = (currentZoomIndex - 1 + displayImagesArray.length) % displayImagesArray.length;
      zoomedImage.src = displayImagesArray[currentZoomIndex];
      resetZoom();
    }
    
    // Custom Dropdown Selection
    function selectCustomOption(inputId, value, displayText, event) {
      if (event) {
        event.preventDefault();
      }
      
      // Update hidden input
      const input = document.getElementById(inputId);
      if (input) input.value = value;
      
      // Update display text
      const display = document.getElementById(inputId + '-display');
      if (display) display.innerText = displayText;
      
      // Update active classes
      if (event && event.currentTarget) {
        const menu = event.currentTarget.closest('.dropdown-menu');
        if (menu) {
          menu.querySelectorAll('.dropdown-item').forEach(item => {
            item.classList.remove('active', 'bg-dark');
          });
          event.currentTarget.classList.add('active', 'bg-dark');
        }
      }
      
      // Trigger total update
      updateTotal();
    }

    // Flatpickr initialization
    const checkInPicker = flatpickr(checkIn, {
      minDate: "today",
      dateFormat: "Y-m-d",
      altInput: true,
      altFormat: "M j, Y",
      disable: bookedDates,
      onChange: function(selectedDates) {
        if(selectedDates.length > 0) {
          const selectedCheckIn = selectedDates[0];
          
          /* 
           * BOOKING OVERLAP LOGIC (FRONTEND):
           * To prevent selecting a checkout date that overlaps with an already booked date,
           * we find the nearest booked date that is after the selected check-in date.
           * We then set the maxDate of the checkOutPicker to this nearest booked date.
           */
          let nextBookedDate = null;
          for (let range of bookedDates) {
             const rangeStart = new Date(range.from);
             if (rangeStart > selectedCheckIn) {
                 if (!nextBookedDate || rangeStart < nextBookedDate) {
                     nextBookedDate = rangeStart;
                 }
             }
          }

          checkOutPicker.set("minDate", selectedCheckIn);
          if (nextBookedDate) {
             checkOutPicker.set("maxDate", nextBookedDate);
          } else {
             checkOutPicker.set("maxDate", null);
          }

          setTimeout(() => checkOutPicker.open(), 100);
        }
        updateTotal();
      }
    });

    const checkOutPicker = flatpickr(checkOut, {
      minDate: "today",
      dateFormat: "Y-m-d",
      altInput: true,
      altFormat: "M j, Y",
      disable: bookedDates,
      onChange: function() {
        updateTotal();
      }
    });

    function updateTotal() {
      const guestCount = parseInt(guests.value);
      const roomCount = parseInt(rooms.value);
      
      let extraCharge = 0;
      if (guestCount > 1) {
        extraCharge = (guestCount - 1) * 300;
      }
      document.getElementById("extraGuestCharge").innerText = extraCharge.toLocaleString("en-IN");

      if (!checkIn.value || !checkOut.value) {
        summaryBlock.style.display = 'none';
        return;
      }

      const inDate = new Date(checkIn.value);
      const outDate = new Date(checkOut.value);
      const diff = Math.ceil((outDate - inDate) / (1000 * 60 * 60 * 24));

      if (diff <= 0) {
        summaryBlock.style.display = 'none';
        return;
      }

      summaryBlock.style.display = 'block';
      totalNights.innerText = diff;

      const pricePerNight = price * roomCount;
      const subtotal = (diff * pricePerNight) + extraCharge;
      const gst = subtotal * 0.18;
      const grandTotal = subtotal + gst;

      document.getElementById("subtotal").innerText = subtotal.toLocaleString("en-IN");
      document.getElementById("gst").innerText = gst.toLocaleString("en-IN");
      document.getElementById("totalPrice").innerText = grandTotal.toLocaleString("en-IN");
    }

    guests.addEventListener("change", updateTotal);
    rooms.addEventListener("change", updateTotal);

    document.getElementById("bookingForm").addEventListener("submit", function (e) {
      if (!checkIn.value || !checkOut.value) {
        e.preventDefault();
        alert("Please select both Check-In and Check-Out dates.");
        return;
      }
      const inDate = new Date(checkIn.value);
      const outDate = new Date(checkOut.value);
      if (outDate <= inDate) {
        e.preventDefault();
        alert("Check-Out must be after Check-In.");
        return;
      }
    });
  </script>
</body>