<% layout("layouts/boilerplate") %>



<div class="listing-container">
  <a href="/listings" class="auth-brand" style="text-decoration:none; display:flex; align-items:center; justify-content:center; gap:8px;">
    <svg class="homigo-logo-icon" viewBox="0 0 100 100" width="36" height="36" xmlns="http://www.w3.org/2000/svg" style="vertical-align: middle;">
      <defs>
        <clipPath id="homigo-pin-clip">
          <path d="M 50 95 C 50 95 95 65 95 45 A 45 45 0 0 0 5 45 C 5 65 50 95 50 95 Z" />
        </clipPath>
      </defs>
      <g clip-path="url(#homigo-pin-clip)">
        <rect x="0" y="0" width="100" height="100" fill="#d59d8c" />
        <polygon points="0,65 50,25 100,65 100,100 0,100" fill="#5f788b" />
        <rect x="70" y="25" width="8" height="20" fill="#ffffff" />
        <polyline points="-10,72 50,25 110,72" fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
      </g>
      <g fill="#ffffff">
        <rect x="41" y="48" width="7" height="7" rx="1" />
        <rect x="52" y="48" width="7" height="7" rx="1" />
        <rect x="41" y="59" width="7" height="7" rx="1" />
        <rect x="52" y="59" width="7" height="7" rx="1" />
      </g>
    </svg>
    <span style="font-family: 'Nunito', sans-serif; color: #5f788b; font-weight:800; font-size: 2rem; text-transform:none; letter-spacing:0;">Homigo</span>
  </a>
  <h1 class="auth-title">Edit Property</h1>
  <p class="auth-subtitle">Update the details of your property to keep it looking great.</p>
  
  <form
    action="/listings/<%= listing._id %>?_method=PUT"
    method="post"
    novalidate
    class="needs-validation"
    enctype="multipart/form-data"
  >
    <div class="auth-label-row">
      <label for="title" class="auth-label">Title</label>
    </div>
    <input
      type="text"
      name="listing[title]"
      id="title"
      value="<%= listing.title %>"
      placeholder="Catchy Property Title"
      class="auth-input form-control"
      required
    />
    <div class="valid-feedback">Title looks good!</div>
    <div class="invalid-feedback">Please enter a property title.</div>

    <div class="auth-label-row">
      <label for="description" class="auth-label">Description</label>
    </div>
    <textarea
      name="listing[description]"
      id="description"
      placeholder="Describe your property in detail..."
      class="auth-input form-control"
      rows="4"
      required
    ><%= listing.description %></textarea>
    <div class="invalid-feedback">Please enter a short description</div>

    <div class="auth-label-row">
      <label class="auth-label">Image Gallery Management</label>
    </div>
    <div class="d-flex flex-wrap gap-4 mb-5" id="image-gallery-container">
      <% if(listing.images && listing.images.length > 0) { %>
        <% listing.images.forEach((img, i) => { %>
          <% let isCover = (listing.image && listing.image.filename === img.filename) || (i === 0 && !listing.image); %>
          <div class="position-relative image-gallery-item" style="width: 180px; padding: 8px; border-radius: 8px; border: 2px solid <%= isCover ? '#222' : 'transparent' %>; background: <%= isCover ? '#f8f9fa' : 'transparent' %>; box-sizing: border-box;">
            <% if(isCover) { %>
              <div class="position-absolute bg-dark text-white px-2 py-1" style="top: -12px; left: -2px; font-size: 0.65rem; border-radius: 12px; z-index: 5; font-weight: bold; letter-spacing: 1px;">COVER PHOTO</div>
            <% } %>
            <img src="<%= img.url.replace('/upload', '/upload/w_250') %>" alt="Listing Image" style="width: 100%; height: 120px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd; margin-bottom: 8px;">
            
            <div class="d-flex flex-column gap-2 mt-2">
              <label class="form-check-label d-flex align-items-center gap-2" style="font-size: 0.85rem; cursor: pointer; font-weight: <%= isCover ? '700' : '500' %>; color: <%= isCover ? '#000' : '#444' %>;">
                <input type="radio" name="coverImage" value="existing:<%= img.filename %>" class="form-check-input m-0" <%= isCover ? 'checked' : '' %>> 
                <span>Set Cover</span>
              </label>
              
              <label class="form-check-label text-danger d-flex align-items-center gap-2" style="font-size: 0.85rem; cursor: pointer; font-weight: 500;">
                <input type="checkbox" name="deleteImages[]" value="<%= img.filename %>" class="form-check-input m-0"> 
                <span>Delete Image</span>
              </label>
            </div>
          </div>
        <% }) %>
      <% } else if(listing.image && listing.image.url) { %>
        <div class="position-relative image-gallery-item" style="width: 180px; padding: 8px; border-radius: 8px; border: 2px solid #222; background: #f8f9fa; box-sizing: border-box;">
          <div class="position-absolute bg-dark text-white px-2 py-1" style="top: -12px; left: -2px; font-size: 0.65rem; border-radius: 12px; z-index: 5; font-weight: bold; letter-spacing: 1px;">COVER PHOTO</div>
          <img src="<%= listing.image.url.replace('/upload', '/upload/w_250') %>" alt="Listing Image" style="width: 100%; height: 120px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd; margin-bottom: 8px;">
          <div class="d-flex flex-column gap-2 mt-2">
            <label class="form-check-label d-flex align-items-center gap-2" style="font-size: 0.85rem; cursor: pointer; font-weight: 700; color: #000;">
              <input type="radio" name="coverImage" value="existing:<%= listing.image.filename %>" class="form-check-input m-0" checked> 
              <span>Set Cover</span>
            </label>
          </div>
        </div>
      <% } %>
      
      <!-- Container for Real-time Previews -->
      <div id="new-uploads-preview" class="d-flex gap-4 flex-wrap"></div>
    </div>

    <div class="auth-label-row">
      <label for="image" class="auth-label">Upload Additional Images</label>
    </div>
    <input
      type="file"
      name="listing[images]"
      id="image"
      class="auth-input form-control"
      multiple
      accept="image/*"
      onchange="previewNewImages(this)"
    />

    <div class="row">
      <div class="col-md-6">
        <div class="auth-label-row">
          <label for="price" class="auth-label">Price per night (₹)</label>
        </div>
        <input
          type="number"
          name="listing[price]"
          id="price"
          value="<%= listing.price %>"
          placeholder="e.g. 12000"
          class="auth-input form-control"
          required
        />
        <div class="invalid-feedback">Please enter a valid Price</div>
      </div>

      <div class="col-md-6">
        <div class="auth-label-row">
          <label for="country" class="auth-label">Country</label>
        </div>
        <input
          type="text"
          name="listing[country]"
          id="country"
          value="<%= listing.country %>"
          placeholder="e.g. India"
          class="auth-input form-control"
          required
        />
        <div class="invalid-feedback">Country should be valid</div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="auth-label-row">
          <label for="location" class="auth-label">Location (City)</label>
        </div>
        <input
          type="text"
          name="listing[location]"
          id="location"
          value="<%= listing.location %>"
          placeholder="e.g. Shimla"
          class="auth-input form-control"
          required
        />
        <div class="invalid-feedback">Location should be valid</div>
      </div>

      <div class="col-md-6">
        <div style="position: relative;">
          <div class="auth-label-row">
            <label for="category" class="auth-label">Property Category</label>
          </div>
          <select name="listing[category]" class="auth-input form-control" id="category" style="appearance: none;" required>
            <option value="Mountains" <%= listing.category === "Mountains" ? "selected" : "" %>>Mountains</option>
            <option value="Beaches" <%= listing.category === "Beaches" ? "selected" : "" %>>Beaches</option>
            <option value="Domes" <%= listing.category === "Domes" ? "selected" : "" %>>Domes</option>
            <option value="Pools" <%= listing.category === "Pools" ? "selected" : "" %>>Pools</option>
            <option value="Forests" <%= listing.category === "Forests" ? "selected" : "" %>>Forests</option>
            <option value="Castles" <%= listing.category === "Castles" ? "selected" : "" %>>Castles</option>
            <option value="Campings" <%= listing.category === "Campings" ? "selected" : "" %>>Campings</option>
            <option value="Farms" <%= listing.category === "Farms" ? "selected" : "" %>>Farms</option>
            <option value="Arctic" <%= listing.category === "Arctic" ? "selected" : "" %>>Arctic</option>
            <option value="House Boats" <%= listing.category === "House Boats" ? "selected" : "" %>>House Boats</option>
          </select>
          <i
            class="fa-solid fa-chevron-down"
            style="
              position: absolute;
              right: 16px;
              top: 45px;
              pointer-events: none;
              color: #888;
            "
          ></i>
          <div class="invalid-feedback">Please select a category</div>
        </div>
      </div>
    </div>

    <button type="submit" class="auth-btn-dark">
      Update Property <i class="fa-solid fa-check"></i>
    </button>
  </form>
</div>

<script>
function previewNewImages(input) {
  const previewContainer = document.getElementById('new-uploads-preview');
  previewContainer.innerHTML = ''; 

  if (input.files) {
    Array.from(input.files).forEach((file, index) => {
      const reader = new FileReader();
      reader.onload = function(e) {
        const itemHtml = `
          <div class="position-relative image-gallery-item" style="width: 180px; padding: 8px; border-radius: 8px; border: 2px dashed #198754; background: #f8fff9; box-sizing: border-box;">
            <div class="position-absolute bg-success text-white px-2 py-1" style="top: -12px; right: -2px; font-size: 0.65rem; border-radius: 12px; z-index: 5; font-weight: bold; letter-spacing: 1px;">NEW UPLOAD</div>
            <img src="${e.target.result}" style="width: 100%; height: 120px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd; margin-bottom: 8px;" alt="Image">
            
            <div class="d-flex flex-column gap-2 mt-2">
              <label class="form-check-label text-success d-flex align-items-center gap-2" style="font-size: 0.85rem; cursor: pointer; font-weight: 600;">
                <input type="radio" name="coverImage" value="new:${index}" class="form-check-input m-0"> 
                <span>Set Cover</span>
              </label>
            </div>
          </div>
        `;
        previewContainer.insertAdjacentHTML('beforeend', itemHtml);
      }
      reader.readAsDataURL(file);
    });
  }
}
</script>
