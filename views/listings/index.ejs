                  </form>
                    </div>
                  </div>
                  <script>
                    document.addEventListener('DOMContentLoaded', () => {
                      const filterForm = document.getElementById('filterForm');
                      if (filterForm) {
                        const filterInputs = filterForm.querySelectorAll('.sidebar-chk');
                        let debounceTimer;

                        filterInputs.forEach(input => {
                          input.addEventListener('change', () => {
                            filterForm.submit();
                          });
                        });

                        // const priceInputs = filterForm.querySelectorAll('input[type="number"]');
                        const priceInputs = [
                          document.getElementById("sidebarPriceMin"),
                          document.getElementById("sidebarPriceMax")
                        ];
                        priceInputs.forEach(input => {
                          input.addEventListener('input', () => {
                            clearTimeout(debounceTimer);
                            debounceTimer = setTimeout(() => {
                              filterForm.submit();
                            }, 1000);
                          });
                        });
                      }
                    });
                  </script>
                </div>

                <!-- Listings Grid -->
                <div class="col-lg-9">
                  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <h2 class="section-title mb-0">Featured Hotels</h2>

                    <div class="d-flex gap-3 align-items-center flex-wrap">
                      <!-- Mobile Filters Toggle -->
                      <button class="btn btn-outline-dark d-lg-none d-flex align-items-center gap-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasFilters" aria-controls="offcanvasFilters" style="border-radius: 20px; font-weight: 600; padding: 0.4rem 1.2rem;">
                        <i class="fa-solid fa-filter"></i> Filters
                      </button>
                      <!-- 
            * SORTING DROPDOWN:
            * This form submits a GET request to /listings when an option is selected.
            * It preserves any existing search parameters (like destination, category) by dynamically
            * creating hidden input fields for them. This ensures filters and sort work together!
          -->
                      <div class="sort-container">
                        <form action="/listings" method="GET" id="sortForm" class="d-flex align-items-center m-0">
                          <% if(typeof searchParams !=='undefined' ) { %>
                            <% for(let key in searchParams) { %>
                              <% if(key !=='sort' ) { %>
                                <input type="hidden" name="<%= key %>" value="<%= searchParams[key] %>">
                                <% } %>
                                  <% } %>
                                    <% } %>
                                      <%
                                        let currentSort = typeof searchParams !== 'undefined' && searchParams.sort ? searchParams.sort : 'ourTopPicks';
                                        let sortLabels = {
                                          'ourTopPicks': 'Our top picks',
                                          'homesFirst': 'Homes & apartments first',
                                          'priceLow': 'Price (lowest first)',
                                          'priceHigh': 'Price (highest first)',
                                          'bestReviewedLowestPrice': 'Best reviewed and lowest price',
                                          'highestRated': 'Property rating (high to low)',
                                          'lowestRated': 'Property rating (low to high)',
                                          'ratingAndPrice': 'Property rating and price',
                                          'distanceFromCityCentre': 'Distance from city centre',
                                          'mostReviewed': 'Top reviewed',
                                          'alphabetical': 'Alphabetical (A-Z)',
                                          'newest': 'Newly Added'
                                        };
                                        let displaySort = sortLabels[currentSort] || 'Our top picks';
                                      %>
                                      
                                      <!-- Custom Dropdown for Sorting -->
                                      <div class="dropdown custom-sort-dropdown">
                                        <button class="btn dropdown-toggle d-flex align-items-center gap-2" type="button" id="sortDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 20px; border: 1px solid #777; background: #f8f9fa; font-weight: 500; color: #333; padding: 0.4rem 1.2rem; font-size: 0.95rem;">
                                          <i class="fa-solid fa-arrow-down-up-across-line text-muted"></i> Sort by: <%= displaySort %>
                                        </button>
                                        <ul class="dropdown-menu shadow border-0 mt-2 py-2" aria-labelledby="sortDropdownBtn" style="border-radius: 12px; min-width: 260px; font-size: 0.95rem;">
                                          <% for(let key in sortLabels) { %>
                                            <li>
                                              <button type="button" class="dropdown-item py-2 px-3 <%= currentSort === key ? 'active' : '' %>" 
                                                      onclick="document.getElementById('hiddenSort').value = '<%= key %>'; document.getElementById('sortForm').submit();" 
                                                      style="<%= currentSort === key ? 'background-color: #f0f4f8; color: #003580; font-weight: 600; border-left: 3px solid #003580;' : 'border-left: 3px solid transparent; color: #444;' %>">
                                                <%= sortLabels[key] %>
                                              </button>
                                            </li>
                                          <% } %>
                                        </ul>
                                      </div>
                                      <input type="hidden" name="sort" id="hiddenSort" value="<%= currentSort %>">
                        </form>
                      </div>

                      <div class="view-toggle btn-group bg-white border"
                        style="border-radius: 20px; overflow: hidden; padding: 2px;">
                        <button class="btn btn-sm active" id="btn-grid-view"
                          style="border-radius: 18px; padding: 4px 12px; font-weight: 500; border: none; background: #003580; color: white;">
                          <i class="fa-solid fa-table-cells-large"></i> Grid
                        </button>
                        <button class="btn btn-sm" id="btn-list-view"
                          style="border-radius: 18px; padding: 4px 12px; font-weight: 500; border: none; color: #555; background: transparent;">
                          <i class="fa-solid fa-list"></i> List
                        </button>
                      </div>

                      <div class="tax-toggle mb-0" style="margin-left: 0;">
                        <div class="form-check form-switch mb-0">
                          <input class="form-check-input" type="checkbox" id="switchCheckDefault">
                          <label class="form-check-label" for="switchCheckDefault">Display Total After Taxes</label>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- 
                  * ACTIVE FILTER CHIPS:
                  * Iterates over all active searchParams (except page and sort) and generates a removable chip for each.
                  * The 'removeUrl' reconstructs the URL without the specific key-value pair, allowing users to remove filters individually.
                  -->
                  <% 
                    let activeFilters = [];
                    const excludedKeys = ['page', 'sort']; 
                    if(typeof searchParams !== 'undefined' && searchParams) {
                      for(let key in searchParams) {
                        if(!excludedKeys.includes(key) && searchParams[key] !== '') {
                          let values = Array.isArray(searchParams[key]) ? searchParams[key] : [searchParams[key]];
                          values.forEach(val => {
                            if(val) {
                              let qsParts = [];
                              for(let k in searchParams) {
                                if(searchParams[k] !== '') {
                                  let kVals = Array.isArray(searchParams[k]) ? searchParams[k] : [searchParams[k]];
                                  kVals.forEach(kV => {
                                    if(!(k === key && kV === val)) {
                                      qsParts.push(encodeURIComponent(k) + '=' + encodeURIComponent(kV));
                                    }
                                  });
                                }
                              }
                              let removeUrl = '/listings?' + qsParts.join('&');
                              if(qsParts.length === 0) removeUrl = '/listings';
                              
                              let displayLabel = val;
                              if(key === 'priceMin') displayLabel = 'Min ₹' + val;
                              if(key === 'priceMax') displayLabel = 'Max ₹' + val;
                              if(key === 'stars') displayLabel = val + ' Stars';
                              if(key === 'rating') displayLabel = val + '+ Rating';
                              
                              activeFilters.push({ label: displayLabel, url: removeUrl });
                            }
                          });
                        }
                      }
                    }
                  %>
                  
                  <% if(activeFilters.length > 0) { %>
                    <div class="d-flex flex-wrap gap-2 mb-4 align-items-center">
                      <span class="text-muted small fw-bold me-1">Active Filters:</span>
                      <% activeFilters.forEach(f => { %>
                        <a href="<%= f.url %>" class="badge rounded-pill bg-white text-dark border text-decoration-none py-2 px-3 shadow-sm filter-chip transition-hover" style="font-size: 0.85rem; font-weight: 600;">
                          <%= f.label %> <i class="fa-solid fa-xmark ms-1 text-danger"></i>
                        </a>
                      <% }) %>
                      <a href="/listings" class="text-danger small fw-bold text-decoration-none ms-2 hover-underline">
                        Clear All
                      </a>
                    </div>
                    <style>
                      .filter-chip:hover {
                        background-color: #f8f9fa !important;
                        border-color: #dc3545 !important;
                        transform: translateY(-2px);
                      }
                      .transition-hover {
                        transition: all 0.2s ease;
                      }
                      .hover-underline:hover {
                        text-decoration: underline !important;
                      }
