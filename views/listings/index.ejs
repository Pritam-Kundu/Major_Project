                                              </li>
                                              <% if (currUser.collections && currUser.collections.length> 0) { %>
                                                <li>
                                                  <hr class="dropdown-divider">
                                                </li>
                                                <li>
                                                  <h6 class="dropdown-header">Save to Collection</h6>
                                                </li>
                                                <% for(let col of currUser.collections) { %>
                                                  <li>
                                                    <form
                                                      action="/wishlist/collections/<%= col._id %>/add/<%= listing._id %>"
                                                      method="POST" class="m-0">
                                                      <button type="submit" class="dropdown-item"
                                                        onclick="event.stopPropagation();">
                                                        <i class="fa-regular fa-folder me-2 text-muted"></i>
                                                        <%= col.name %>
