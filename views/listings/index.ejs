                                        <%=typeof searchParams !=='undefined' && searchParams && searchParams.safety && (Array.isArray(searchParams.safety) ? searchParams.safety.includes(s) : searchParams.safety === s) ? 'checked' : '' %>>
                                      <div class="checkmark"></div>
                                      <span class="checkbox-label"><%= s %></span>
