                                  <div class="booking-price-section">
                                    <div>
                                      <span class="price-original">&#8377;<%= originalPrice.toLocaleString("en-IN") %>
                                      </span>
                                      <span class="price-current">&#8377;<%= listing.price.toLocaleString("en-IN") %>
