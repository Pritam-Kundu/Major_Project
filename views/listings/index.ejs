                                </div>

                                <div class="filter-section">
                                  <h4 class="filter-title">Host Features</h4>
                                  <% const hostFeatures = ['Verified Host', 'Super Host', 'Highly Rated Host']; %>
                                  <% for(let hf of hostFeatures) { %>
                                    <label class="custom-checkbox">
                                      <input type="checkbox" name="hostFeatures" class="sidebar-chk" value="<%= hf %>"
                                        <%=typeof searchParams !=='undefined' && searchParams && searchParams.hostFeatures && (Array.isArray(searchParams.hostFeatures) ? searchParams.hostFeatures.includes(hf) : searchParams.hostFeatures === hf) ? 'checked' : '' %>>
                                      <div class="checkmark"></div>
                                      <span class="checkbox-label"><%= hf %></span>
                                    </label>
