                                      <input type="checkbox" name="accessibility" class="sidebar-chk" value="<%= acc %>"
                                        <%=typeof searchParams !=='undefined' && searchParams && searchParams.accessibility && (Array.isArray(searchParams.accessibility) ? searchParams.accessibility.includes(acc) : searchParams.accessibility === acc) ? 'checked' : '' %>>
                                      <div class="checkmark"></div>
                                      <span class="checkbox-label"><%= acc %></span>
