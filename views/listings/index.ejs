                          ratingScore=listing.avgRating ? listing.avgRating.toFixed(1) : "New" ; let
                          reviewCount=listing.reviewCount || 0; let originalPrice=Math.round(listing.price * 1.2); let
                          ratingWord=listing.avgRating>= 4.5 ? "Superb" :
                          (listing.avgRating >= 4.0 ? "Fabulous" : (listing.avgRating ? "Good" : "No Reviews"));
                          let hasFreeCancel = (idStr.charCodeAt(3) % 2) === 0;
                          let hasPool = (idStr.charCodeAt(4) % 2) === 0;
                          let amenitiesArr = ["wifi", "breakfast"];
                          if (hasFreeCancel) amenitiesArr.push("cancel");
                          if (hasPool) amenitiesArr.push("pool");
                          let amenitiesStr = amenitiesArr.join(",");
                          %>
                          <div class="col listing-card-wrapper" data-category="<%= listing.category %>"
                            data-price="<%= listing.price %>" data-stars="<%= starCount %>"
                            data-rating="<%= ratingScore %>" data-amenities="<%= amenitiesStr %>">
                            <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none">
                              <div class="booking-card h-100">
                                <div class="booking-card-img-container skeleton-loading">
                                  <img src="<%= listing.image.url %>" class="booking-card-img" alt="listing_image">
                                  <% if(hasFreeCancel) { %>
                                    <div class="badge-cancel">Free Cancellation</div>
                                    <% } %>

                                      <!-- Heart Dropdown Container -->
                                      <div class="dropdown"
                                        style="position: absolute; top: 10px; right: 10px; z-index: 10;">
                                        <div class="badge-heart m-0" style="position: relative;"
                                          data-bs-toggle="dropdown" aria-expanded="false"
                                          onclick="event.preventDefault(); event.stopPropagation();">
                                          <% if(currUser && currUser.wishlist &&
                                            currUser.wishlist.includes(listing._id)) { %>
                                            <i class="fa-solid fa-heart text-danger"></i>
                                            <% } else { %>
                                              <i class="fa-regular fa-heart"></i>
                                              <% } %>
                                        </div>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0"
                                          onclick="event.preventDefault(); event.stopPropagation();">
                                          <% if(!currUser) { %>
                                            <li><a class="dropdown-item" href="/login">Log in to save</a></li>
                                            <% } else { %>
                                              <li>
                                                <form action="/wishlist/<%= listing._id %>" method="POST" class="m-0">
                                                  <button type="submit" class="dropdown-item fw-bold"
                                                    onclick="event.stopPropagation();">
                                                    <% if(currUser.wishlist && currUser.wishlist.includes(listing._id))
                                                      { %>
                                                      Remove from Wishlist
