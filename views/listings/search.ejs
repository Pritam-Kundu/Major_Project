    <script>
      const taxSwitch = document.getElementById("switchCheckDefault");
      if (taxSwitch) {
        taxSwitch.addEventListener("change", (e) => {
          let taxInfo = document.getElementsByClassName("tax-info");
          for (let info of taxInfo) {
            info.style.display = e.target.checked ? "block" : "none";
          }
        });
      }
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const btnGrid = document.getElementById('btn-grid-view');
        const btnList = document.getElementById('btn-list-view');
        const gridContainer = document.getElementById('listings-grid');

        if (!btnGrid || !btnList || !gridContainer) return;

        const currentView = localStorage.getItem('wanderlust_view_preference') || 'grid';
        if (currentView === 'list') {
          enableListView();
        }

        btnGrid.addEventListener('click', (e) => {
          e.preventDefault();
          enableGridView();
        });

        btnList.addEventListener('click', (e) => {
          e.preventDefault();
          enableListView();
        });

        function enableListView() {
          gridContainer.classList.add('list-view-active');
          btnList.classList.add('active');
          btnList.style.background = '#003580';
          btnList.style.color = 'white';
          btnGrid.classList.remove('active');
          btnGrid.style.background = 'transparent';
          btnGrid.style.color = '#555';
          localStorage.setItem('wanderlust_view_preference', 'list');
        }

        function enableGridView() {
          gridContainer.classList.remove('list-view-active');
          btnGrid.classList.add('active');
          btnGrid.style.background = '#003580';
          btnGrid.style.color = 'white';
          btnList.classList.remove('active');
          btnList.style.background = 'transparent';
          btnList.style.color = '#555';
          localStorage.setItem('wanderlust_view_preference', 'grid');
        }
      });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const updateDayText = (dateObj, elementId) => {
          if (!dateObj || !dateObj[0]) return;
          const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
          document.getElementById(elementId).innerText = days[dateObj[0].getDay()];
        };

        const checkInPicker = flatpickr("#agodaCheckIn", {
          altInput: true,
          altFormat: "d M Y",
          dateFormat: "Y-m-d",
          minDate: "today",
          onChange: function (selectedDates) {
            updateDayText(selectedDates, "checkInDay");
            checkOutPicker.set("minDate", selectedDates[0] || "today");
          },
          onReady: function (selectedDates) {
            if (selectedDates.length > 0) updateDayText(selectedDates, "checkInDay");
          }
        });

        const checkOutPicker = flatpickr("#agodaCheckOut", {
          altInput: true,
          altFormat: "d M Y",
          dateFormat: "Y-m-d",
          minDate: "today",
          onChange: function (selectedDates) {
            updateDayText(selectedDates, "checkOutDay");
          },
          onReady: function (selectedDates) {
            if (selectedDates.length > 0) updateDayText(selectedDates, "checkOutDay");
          }
        });
      });
    </script>