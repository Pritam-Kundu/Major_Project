    <div class="search-summary-container">
      <div class="search-summary-inner" style="display: block;">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
        <form class="wl-form" role="search" method="GET" action="/listings/search">
          <!-- Destination -->
          <div class="wl-group">
            <label class="wl-label">Destination</label>
            <div class="wl-input-wrapper" style="background: #f8f9fa; border: 1px solid #ced4da;">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input type="search" id="search" name="search" placeholder="Search locations..." list="destinations"
                autocomplete="off"
                value="<%= typeof searchParams !== 'undefined' && searchParams.search ? searchParams.search : '' %>">
              <datalist id="destinations">
                <option value="Goa"></option>
                <option value="Manali"></option>
                <option value="Kerala"></option>
                <option value="Jaipur"></option>
                <option value="New York City"></option>
                <option value="Paris"></option>
                <option value="Santorini"></option>
                <option value="Bali"></option>
              </datalist>
            </div>
          </div>

          <div class="wl-divider" style="background: #e9ecef;"></div>

          <!-- Dates -->
          <div class="wl-group">
            <label class="wl-label">Dates</label>
            <div class="wl-dates-wrapper">
              <div class="wl-date-box" onclick="document.getElementById('agodaCheckIn')._flatpickr.open()"
                style="background: #f8f9fa; border: 1px solid #ced4da;">
                <span class="wl-date-title">Check-in</span>
                <input type="text" id="agodaCheckIn" name="checkIn" class="wl-date-input" placeholder="Add dates"
                  value="<%= typeof searchParams !== 'undefined' && searchParams.checkIn ? searchParams.checkIn : '' %>">
              </div>
              <div class="wl-date-box" onclick="document.getElementById('agodaCheckOut')._flatpickr.open()"
                style="background: #f8f9fa; border: 1px solid #ced4da;">
                <span class="wl-date-title">Check-out</span>
                <input type="text" id="agodaCheckOut" name="checkOut" class="wl-date-input" placeholder="Add dates"
                  value="<%= typeof searchParams !== 'undefined' && searchParams.checkOut ? searchParams.checkOut : '' %>">
              </div>
            </div>
          </div>

          <div class="wl-divider" style="background: #e9ecef;"></div>

          <!-- Guests -->
          <div class="wl-group">
            <label class="wl-label">Guests</label>
            <div class="wl-guests-wrapper">
              <div class="wl-guest-row">
                <span>Adults</span>
                <div class="wl-counter" style="background: #f8f9fa; border: 1px solid #ced4da;">
                  <button type="button" class="wl-btn"
                    onclick="const i=document.getElementById('guests-adults'); if(i.value>1)i.value--">-</button>
                  <input type="number" id="guests-adults" name="guests"
                    value="<%= typeof searchParams !=='undefined' && searchParams.guests ? searchParams.guests : '2' %>"
                    readonly>
                  <button type="button" class="wl-btn"
                    onclick="document.getElementById('guests-adults').value++">+</button>
                </div>
              </div>
              <div class="wl-guest-row">
                <span>Children</span>
                <div class="wl-counter" style="background: #f8f9fa; border: 1px solid #ced4da;">
                  <button type="button" class="wl-btn"
                    onclick="const i=document.getElementById('guests-children'); if(i.value>0)i.value--">-</button>
                  <input type="number" id="guests-children" name="children"
                    value="<%= typeof searchParams !=='undefined' && searchParams.children ? searchParams.children : '0' %>"
                    readonly>
                  <button type="button" class="wl-btn"
                    onclick="document.getElementById('guests-children').value++">+</button>
                </div>
              </div>
            </div>
          </div>

          <div class="wl-divider" style="background: #e9ecef;"></div>

          <!-- Property Type -->
          <div class="wl-group">
            <label class="wl-label">Property Type</label>
            <div class="wl-input-wrapper wl-property-type wl-custom-dropdown" id="propertyTypeDropdown"
              style="background: #f8f9fa; border: 1px solid #ced4da;">
              <div class="wl-dropdown-selected">
                <span id="selected-property-text">Villas, Boutique Hotels, Eco-lodges</span>
                <i class="fa-solid fa-chevron-down wl-chevron"></i>
              </div>
              <div class="wl-dropdown-options">
                <div class="wl-dropdown-option" data-value="Any">Villas, Boutique Hotels, Eco-lodges</div>
                <% const pTypes=["Beaches", "Mountains" , "Forests" , "Castles" , "Pools" , "Campings" , "Farms"
                  , "Arctic" , "House Boats" , "Domes" ]; %>
                  <% for(let p of pTypes) { %>
                    <div class="wl-dropdown-option" data-value="<%= p %>">
                      <%= p %>
                    </div>
                    <% } %>
              </div>
              <input type="hidden" name="propertyType" id="propertyTypeInput"
                value="<%= typeof searchParams !=='undefined' && searchParams.propertyType ? searchParams.propertyType : 'Any' %>">
            </div>
          </div>

          <button class="wl-search-btn" type="submit">Search</button>
        </form>

        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const dropdown = document.getElementById('propertyTypeDropdown');
            const selectedText = document.getElementById('selected-property-text');
            const hiddenInput = document.getElementById('propertyTypeInput');
            const options = document.querySelectorAll('.wl-dropdown-option');

            if (dropdown) {
              dropdown.addEventListener('click', (e) => {
                dropdown.classList.toggle('active');
              });

              options.forEach(opt => {
                opt.addEventListener('click', (e) => {
                  const val = opt.getAttribute('data-value');
                  hiddenInput.value = val;
                  selectedText.textContent = opt.textContent;
                });
              });

              document.addEventListener('click', (e) => {
                if (!dropdown.contains(e.target)) {
                  dropdown.classList.remove('active');
                }
              });

              const initialVal = hiddenInput.value;
              if (initialVal && initialVal !== 'Any') {
                selectedText.textContent = initialVal;
              }
            }

            // --- Date Validation for Search Form ---
            // Validates that Check-in date is not after Check-out date.
            // If invalid, prevents submission and shows a styled notification.
            const searchForm = document.querySelector('.wl-form');
            if (searchForm) {
              searchForm.addEventListener('submit', (e) => {
                const checkInVal = document.getElementById('agodaCheckIn').value;
                const checkOutVal = document.getElementById('agodaCheckOut').value;

                if (checkInVal && checkOutVal) {
                  const checkInDate = new Date(checkInVal);
                  const checkOutDate = new Date(checkOutVal);

                  if (checkInDate > checkOutDate) {
                    e.preventDefault(); // Stop form submission

                    // Remove existing client error toast if present to prevent duplicates
                    const existingToast = document.getElementById('clientErrorToast');
                    if (existingToast) existingToast.remove();

                    // Inject a custom error toast matching the application's design
                    const toastHtml = `
                      <div class="custom-toast error" id="clientErrorToast">
                          <div class="custom-toast-icon">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                  <circle cx="12" cy="12" r="10"></circle>
                                  <line x1="12" y1="8" x2="12" y2="12"></line>
                                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                              </svg>
                          </div>
                          <p class="custom-toast-text">Check-out date cannot be earlier than check-in date.</p>
                          <button type="button" class="custom-toast-close" onclick="closeToast('clientErrorToast')" aria-label="Close">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2c2c2c" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                                  <line x1="18" y1="6" x2="6" y2="18"></line>
                                  <line x1="6" y1="6" x2="18" y2="18"></line>
                              </svg>
                          </button>
                      </div>`;

                    document.body.insertAdjacentHTML('beforeend', toastHtml);

                    // Auto-dismiss after 6 seconds
                    setTimeout(() => {
                      if (typeof closeToast === 'function') {
                        closeToast('clientErrorToast');
                      } else {
                        const t = document.getElementById('clientErrorToast');
                        if (t) t.remove();
                      }
                    }, 6000);
                  }
                }
              });
            }
          });
        </script>
      </div>
    </div>

    <div class="row mt-4">
      <!-- Sidebar Filters -->
      <!-- Added filter-sidebar-container to apply sticky logic at the correct flex level -->
      <div class="col-lg-3 mb-4 filter-sidebar-container">
        <!-- 
          Responsive Offcanvas Wrapper for Sidebar Filters
          - 'offcanvas-lg': This Bootstrap 5 class keeps the element as a standard block on large screens (desktops), but transforms it into a hidden slide-in drawer on small screens (mobile/tablets).
          - 'offcanvas-start': Means the drawer slides in from the left side of the screen.
        -->
        <div class="offcanvas-lg offcanvas-start" tabindex="-1" id="offcanvasFilters" aria-labelledby="offcanvasFiltersLabel">
          <div class="offcanvas-header d-lg-none border-bottom">
