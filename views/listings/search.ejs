      /* 
       * STICKY FILTER SIDEBAR
       * Applied to the parent column (.col-lg-3) so the entire block sticks naturally.
       * 'align-self: flex-start' prevents the column from stretching to full row height,
       * which is mandatory for position: sticky to work inside a flex container!
       */
      @media(min-width: 992px) {
        .filter-sidebar-container {
          position: sticky;
          top: 85px; /* Offset for the glassmorphism navbar */
          align-self: flex-start;
          z-index: 10;
          /* 
           * To elegantly handle the edge case where the sidebar is taller than the viewport, 
           * we let it scroll normally and stick to the bottom of the viewport instead! 
           * top: min(...) ensures it sticks to the top if short, or sticks to the bottom if tall!
           * Wait, top % refers to containing block. We will just use the standard sticky top.
           */
        }
      }

