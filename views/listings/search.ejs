                            <span class="price-original">&#8377;<%= originalPrice.toLocaleString("en-IN") %>
                            </span>
                            <span class="price-current">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                          </div>
                          <div class="price-tax tax-info" style="display: none;">
                            + &#8377;<%= Math.round(listing.price * 0.18).toLocaleString("en-IN") %> taxes and
                              charges
                          </div>
                          <div class="price-tax" style="color: #666;">Per night</div>
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
                <% } %>
            </div>

            <!-- Pagination -->
            <% if (totalPages> 1) { %>
              <div class="pagination-container">
                <ul class="pagination">
                  <% function getPageUrl(page) { const params=new URLSearchParams(); if (typeof searchParams
                    !=="undefined" ) { for (let key in searchParams) { if (key==="page" ) continue; if
                    (Array.isArray(searchParams[key])) { searchParams[key].forEach(val=> params.append(key, val));

                    } else if (searchParams[key] !== "") {

                    params.append(key, searchParams[key]);

                    }

                    }

                    }

                    params.set("page", page);

                    return "/listings/search?" + params.toString();

                    }
                    %>

                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                      <a class="page-link"
                        href="<%= currentPage === 1 ? '#' : getPageUrl(currentPage - 1) %>">Previous</a>
