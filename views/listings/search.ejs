                            <input type="checkbox" name="accessibility" class="sidebar-chk" value="<%= acc %>"
                              <%=searchParams.accessibility && (Array.isArray(searchParams.accessibility) ? searchParams.accessibility.includes(acc) : searchParams.accessibility === acc) ? 'checked' : '' %>>
                            <div class="checkmark"></div>
                            <span class="checkbox-label"><%= acc %></span>
                          </label>
                        <% } %>
                      </div>

                      <!-- Clear Filters Button anchored at bottom -->
