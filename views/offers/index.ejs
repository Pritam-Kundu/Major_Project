<% layout("layouts/boilerplate") %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap');

  .offers-body {
    font-family: 'Outfit', sans-serif;
    background-color: #f8f9fc;
    min-height: 100vh;
    padding-bottom: 4rem;
  }

  /* Header Section */
  .offers-header {
    background: linear-gradient(135deg, #1a2a6c, #11998e, #38ef7d);
    background-size: 200% 200%;
    animation: gradientBG 10s ease infinite;
    color: white;
    padding: 5rem 2rem;
    text-align: center;
    border-radius: 0 0 40px 40px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
    margin-bottom: 3rem;
    margin-top: -1.5rem; /* pull up under navbar */
  }

  @keyframes gradientBG {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .offers-header h1 {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    text-shadow: 0 4px 15px rgba(0,0,0,0.2);
  }

  .offers-header p {
    font-size: 1.2rem;
    font-weight: 300;
    opacity: 0.9;
  }

  /* Offer Grid */
  .offers-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  /* Offer Card - Premium Glassmorphism & Hover Lift */
  .offer-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }

  .offer-card:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 25px 45px rgba(0, 0, 0, 0.12);
  }

  .offer-image-container {
    height: 180px;
    position: relative;
    overflow: hidden;
  }

  .offer-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .offer-card:hover .offer-image-container img {
    transform: scale(1.1);
  }

  /* Ribbons & Badges */
  .ribbon-flash {
    position: absolute;
    top: 15px;
    left: -35px;
    background: linear-gradient(45deg, #ff416c, #ff4b2b);
    color: white;
    padding: 5px 40px;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    transform: rotate(-45deg);
    box-shadow: 0 4px 10px rgba(255, 75, 43, 0.4);
    z-index: 2;
    animation: pulseFlash 2s infinite;
  }

  @keyframes pulseFlash {
    0% { transform: rotate(-45deg) scale(1); }
    50% { transform: rotate(-45deg) scale(1.05); }
    100% { transform: rotate(-45deg) scale(1); }
  }

  .badge-category {
    position: absolute;
    top: 15px;
    right: 15px;
    background: rgba(255,255,255,0.9);
    color: #333;
    padding: 5px 12px;
    border-radius: 30px;
    font-size: 0.75rem;
    font-weight: 700;
    z-index: 2;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .offer-details {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .offer-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #1a1a1a;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .offer-desc {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .discount-box {
    background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
    border-radius: 12px;
    padding: 10px;
    text-align: center;
    margin-bottom: 1rem;
    border: 1px dashed #fff;
  }
  
  .discount-text {
    font-weight: 800;
    font-size: 1.3rem;
    color: #2b2b2b;
  }

  /* FOMO Timer */
  .fomo-timer {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: #e63946;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .fomo-stats {
    font-size: 0.75rem;
    color: #888;
    margin-bottom: 1rem;
  }

  .claim-btn {
    background: linear-gradient(90deg, #ff512f, #dd2476);
    border: none;
    color: white;
    font-weight: 700;
    padding: 12px;
    border-radius: 12px;
    width: 100%;
    transition: all 0.3s;
    margin-top: auto;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  
  .claim-btn::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    transition: all 0.5s;
    z-index: -1;
  }

  .claim-btn:hover::before {
    left: 100%;
  }

  .claim-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(221, 36, 118, 0.4);
    color: white;
  }

  .claim-btn.claimed {
    background: #4caf50;
    pointer-events: none;
    box-shadow: none;
  }

  .terms-link {
    font-size: 0.7rem;
    color: #999;
    text-align: center;
    margin-top: 10px;
    display: block;
  }

  /* Toast Customization */
  .toast-container {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
  }

  /* Modal Premium styling */
  .offer-modal .modal-content {
    border-radius: 25px;
    border: none;
    overflow: hidden;
  }
  .offer-modal .modal-header {
    border-bottom: none;
    padding: 0;
    position: relative;
  }
  .offer-modal .modal-header img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }
  .offer-modal .btn-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: white;
    border-radius: 50%;
    padding: 10px;
    opacity: 0.9;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  }
  .offer-modal .modal-body {
    padding: 1.5rem;
  }
  .modal-discount {
    font-size: 2.5rem;
    font-weight: 800;
    background: -webkit-linear-gradient(#ff512f, #dd2476);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .promo-code-box {
    background: #f1f3f5;
    border: 2px dashed #ccc;
    padding: 15px;
    text-align: center;
    border-radius: 12px;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: #333;
    margin: 1.5rem 0;
    user-select: all;
  }

  /* Responsive Grid */
  @media (max-width: 768px) {
    .offers-header { padding: 3rem 1rem; border-radius: 0 0 20px 20px; }
    .offers-header h1 { font-size: 2.2rem; }
    .offer-grid { 
      grid-template-columns: 1fr; 
      gap: 1.5rem;
    }
  }

</style>

<div class="offers-body">
  <div class="offers-header">
    <h1>Exclusive Offers for You</h1>
    <p>Unlock premium travel experiences with our limited-time deals</p>
  </div>

  <div class="offers-container">
    <div class="offer-grid">
      <% if(offers && offers.length > 0) { %>
        <% offers.forEach(function(offer) { %>
          <% 
            let icon = "fa-tag";
            let color = "#333";
            if(offer.category === "Limited Time Deals") { icon = "fa-fire text-danger"; }
            else if(offer.category === "Flat ₹500 OFF") { icon = "fa-money-bill-wave text-success"; }
            else if(offer.category === "Stay 2 Nights, Get 1 Free") { icon = "fa-hotel text-primary"; }
            else if(offer.category === "New User Special") { icon = "fa-gift text-warning"; }
            else if(offer.category === "Bank Offers") { icon = "fa-credit-card text-info"; }
            else if(offer.category === "Premium Member Exclusive") { icon = "fa-gem text-primary"; }
            else if(offer.category === "Trending") { icon = "fa-arrow-trend-up text-danger"; }
            
            // Generate some fake stats for FOMO
            const claimed = offer.claimedUsers ? offer.claimedUsers.length : Math.floor(Math.random() * 200) + 50;
            const left = offer.maxClaims ? (offer.maxClaims - claimed) : Math.floor(Math.random() * 15) + 2;
            
            // Check if current user claimed this
            const hasClaimed = currUser && currUser.claimedOffers && currUser.claimedOffers.includes(offer._id);
          %>
          
          <div class="offer-card" onclick="openOfferModal('<%= offer._id %>')">
            
            <% if(offer.category === "Trending" || offer.category === "Limited Time Deals") { %>
              <div class="ribbon-flash">FLASH SALE</div>
            <% } %>

            <div class="offer-image-container">
              <img src="<%= offer.image %>" alt="<%= offer.title %>">
              <div class="badge-category">
                <i class="fa-solid <%= icon %>"></i> <%= offer.category %>
              </div>
            </div>
            
            <div class="offer-details">
              <h3 class="offer-title"><%= offer.title %></h3>
              <p class="offer-desc"><%= offer.description %></p>
              
              <div class="discount-box">
                <span class="discount-text"><%= offer.discount %></span>
              </div>
              
              <div class="fomo-timer" data-expiry="<%= offer.expiryDate.toISOString() %>">
                <i class="fa-regular fa-clock fa-spin" style="--fa-animation-duration: 3s;"></i>
                <span class="countdown-text">Calculating...</span>
              </div>
              
              <div class="fomo-stats">
                <i class="fa-solid fa-bolt text-warning"></i> Claimed by <%= claimed %> users today. <strong>Only <%= left > 0 ? left : 'few' %> left!</strong>
              </div>
              
              <% if(hasClaimed) { %>
                <button class="claim-btn claimed" onclick="event.stopPropagation();">
                  <i class="fa-solid fa-check-circle me-1"></i> Claimed
                </button>
              <% } else { %>
                <button class="claim-btn btn-claim-action" data-id="<%= offer._id %>" onclick="event.stopPropagation(); claimOffer('<%= offer._id %>', this)">
                  Claim Offer <i class="fa-solid fa-arrow-right ms-2"></i>
                </button>
              <% } %>
              
              <span class="terms-link">*Terms & Conditions apply</span>
            </div>
            
            <!-- Hidden Data for Modal -->
            <div id="offer-data-<%= offer._id %>" style="display:none;" 
                 data-title="<%= offer.title %>"
                 data-desc="<%= offer.description %>"
                 data-discount="<%= offer.discount %>"
                 data-promo="<%= offer.promoCode || 'N/A' %>"
                 data-img="<%= offer.image %>"
                 data-expiry="<%= offer.expiryDate.toISOString() %>"
                 data-claimed="<%= hasClaimed %>">
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <i class="fa-solid fa-ticket fa-4x text-muted mb-3 opacity-50"></i>
          <h3 class="text-muted fw-bold">No Active Offers Right Now</h3>
          <p class="text-muted">Check back later for exciting travel deals.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Premium Offer Details Modal -->
<div class="modal fade offer-modal" id="offerDetailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <img src="" id="modalImg" alt="Offer Image">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <h3 id="modalTitle" class="fw-bold mb-3"></h3>
        <p id="modalDesc" class="text-muted mb-4"></p>
        
        <div class="modal-discount" id="modalDiscount"></div>
        
        <div id="modalPromoContainer">
          <p class="mb-1 text-muted small mt-4">Use Promo Code at checkout:</p>
          <div class="promo-code-box" id="modalPromo"></div>
        </div>
        
        <div class="fomo-timer justify-content-center mt-3 mb-4" id="modalTimerBox" data-expiry="">
          <i class="fa-regular fa-clock"></i>
          <span class="countdown-text" id="modalTimer"></span>
        </div>

        <button id="modalClaimBtn" class="claim-btn w-100 py-3 fs-5" onclick="claimModalOffer()">Claim Offer</button>
        
        <div class="text-start mt-4 pt-3 border-top">
          <h6 class="fw-bold fs-6">Eligibility & Terms:</h6>
          <ul class="text-muted small ps-3 mb-0" style="font-size: 0.8rem;">
            <li>Offer valid only for logged-in users.</li>
            <li>Cannot be combined with other existing offers.</li>
            <li>Wanderlust reserves the right to modify or cancel the offer at any time.</li>
            <li>Standard cancellation policies apply.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Toast for Notifications -->
<div class="toast-container">
  <div id="offerToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body fw-bold" id="toastMessage">
        <i class="fa-solid fa-circle-check me-2"></i> Offer successfully claimed!
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>

<script>
  // Countdown Timer Logic
  function updateTimers() {
    document.querySelectorAll('.fomo-timer').forEach(timer => {
      const expiry = new Date(timer.getAttribute('data-expiry'));
      if(!expiry || isNaN(expiry)) return;
      
      const now = new Date();
      const diff = expiry - now;
      
      const textSpan = timer.querySelector('.countdown-text');
      
      if (diff <= 0) {
        textSpan.innerHTML = "Expired";
        timer.style.color = "#888";
        return;
      }
      
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      
      if (days > 1) {
        textSpan.innerHTML = `Expires in ${days} days`;
      } else {
        textSpan.innerHTML = `Expires in ${hours}h ${mins}m`;
      }
    });
  }

  setInterval(updateTimers, 60000); // update every minute
  document.addEventListener('DOMContentLoaded', updateTimers);

  // Claim Offer AJAX function
  let currentModalOfferId = null;

  async function claimOffer(id, btnElement) {
    <% if(!currUser) { %>
      window.location.href = '/login';
      return;
    <% } %>
    
    // Original button text
    const originalText = btnElement.innerHTML;
    btnElement.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';
    btnElement.style.pointerEvents = 'none';

    try {
      const res = await fetch(`/offers/${id}/claim`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        }
      });
      const data = await res.json();
      
      if(data.success) {
        // Change button to claimed
        btnElement.innerHTML = '<i class="fa-solid fa-check-circle me-1"></i> Claimed';
        btnElement.classList.add('claimed');
        
        // Update hidden data so modal knows it's claimed
        document.getElementById(`offer-data-${id}`).setAttribute('data-claimed', 'true');
        
        // Show Toast
        showToast("Offer successfully claimed! View it in your account.", "bg-success");
      } else {
        btnElement.innerHTML = originalText;
        btnElement.style.pointerEvents = 'auto';
        showToast(data.message || "Failed to claim offer.", "bg-danger");
      }
    } catch(err) {
      console.error(err);
      btnElement.innerHTML = originalText;
      btnElement.style.pointerEvents = 'auto';
      showToast("Network error. Please try again.", "bg-danger");
    }
  }

  function showToast(msg, bgClass) {
    const toastEl = document.getElementById('offerToast');
    const toastBody = document.getElementById('toastMessage');
    toastEl.className = `toast align-items-center text-white border-0 ${bgClass}`;
    toastBody.innerHTML = bgClass === 'bg-success' 
      ? `<i class="fa-solid fa-circle-check me-2"></i> ${msg}`
      : `<i class="fa-solid fa-circle-exclamation me-2"></i> ${msg}`;
    
    const toast = new bootstrap.Toast(toastEl);
    toast.show();
  }

  // Modal Logic
  function openOfferModal(id) {
    const dataEl = document.getElementById(`offer-data-${id}`);
    if(!dataEl) return;
    
    currentModalOfferId = id;
    
    document.getElementById('modalTitle').textContent = dataEl.getAttribute('data-title');
    document.getElementById('modalDesc').textContent = dataEl.getAttribute('data-desc');
    document.getElementById('modalDiscount').textContent = dataEl.getAttribute('data-discount');
    document.getElementById('modalImg').src = dataEl.getAttribute('data-img');
    
    const promo = dataEl.getAttribute('data-promo');
    if(promo && promo !== 'N/A') {
      document.getElementById('modalPromoContainer').style.display = 'block';
      document.getElementById('modalPromo').textContent = promo;
    } else {
      document.getElementById('modalPromoContainer').style.display = 'none';
    }
    
    const expiry = dataEl.getAttribute('data-expiry');
    document.getElementById('modalTimerBox').setAttribute('data-expiry', expiry);
    
    const isClaimed = dataEl.getAttribute('data-claimed') === 'true';
    const claimBtn = document.getElementById('modalClaimBtn');
    
    if(isClaimed) {
      claimBtn.innerHTML = '<i class="fa-solid fa-check-circle me-1"></i> Claimed';
      claimBtn.classList.add('claimed');
      claimBtn.disabled = true;
    } else {
      claimBtn.innerHTML = 'Claim Offer <i class="fa-solid fa-arrow-right ms-2"></i>';
      claimBtn.classList.remove('claimed');
      claimBtn.disabled = false;
    }
    
    updateTimers(); // force update modal timer
    
    const modal = new bootstrap.Modal(document.getElementById('offerDetailsModal'));
    modal.show();
  }

  function claimModalOffer() {
    if(!currentModalOfferId) return;
    const claimBtn = document.getElementById('modalClaimBtn');
    // Find the corresponding button on the grid to update it too
    const gridBtn = document.querySelector(`.btn-claim-action[data-id="${currentModalOfferId}"]`);
    
    // Simulate clicking the grid button to reuse logic
    if(gridBtn) {
      claimBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';
      claimOffer(currentModalOfferId, gridBtn).then(() => {
        // Update modal button after grid logic finishes
        if(gridBtn.classList.contains('claimed')) {
           claimBtn.innerHTML = '<i class="fa-solid fa-check-circle me-1"></i> Claimed';
           claimBtn.classList.add('claimed');
           claimBtn.disabled = true;
        } else {
           claimBtn.innerHTML = 'Claim Offer <i class="fa-solid fa-arrow-right ms-2"></i>';
        }
      });
    }
  }
</script>
